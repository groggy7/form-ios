    "paywall.form_lab.benefit4_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Post-workout backups save locally and to a selected folder when configured; off-device sync depends on its provider."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenman sonrası yedekler yerel olarak, klasör seçtiyseniz oraya da kaydedilir; cihaz dışı eşitleme sağlayıcıya bağlıdır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups nach dem Training werden lokal und bei entsprechender Einrichtung in einem gewählten Ordner gespeichert. Die Synchronisierung außerhalb des Geräts hängt vom Anbieter ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes après séance sont enregistrées localement et dans le dossier choisi, s’il est configuré. La synchronisation hors de l’appareil dépend du fournisseur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias tras entrenar se guardan localmente y en una carpeta elegida si está configurada. La sincronización fuera del dispositivo depende del proveedor."
          }
        }
      }
    },
