    "onboarding.reason.homeForge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matched for home training with dumbbells and an adjustable bench with balanced frequency."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evde dambıl ve ayarlanabilir sehpa ile dengeli frekansta antrenman için eşleştirildi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passend für Heimtraining mit Kurzhanteln und einer verstellbaren Bank mit ausgewogener Frequenz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapté pour l'entraînement à domicile avec haltères et un banc réglable à fréquence équilibrée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegido para entrenar en casa con mancuernas y un banco ajustable, con una frecuencia equilibrada."
          }
        }
      }
    },
    "onboarding.reason.bodyweightBase": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matched for home training without equipment: three short full-body sessions you progress with harder variations."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekipmansız ev antrenmanı için eşleştirildi: daha zor varyasyonlarla ilerleyen üç kısa tüm vücut seansı."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passend für Heimtraining ohne Geräte: drei kurze Ganzkörpereinheiten, die du mit schwereren Varianten steigerst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapté à l’entraînement à domicile sans équipement : trois courtes séances corps entier, à faire progresser avec des variantes plus difficiles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegido para entrenar en casa sin equipo: tres sesiones cortas de cuerpo completo que progresas con variantes más difíciles."
          }
        }
      }
    },
    "onboarding.reason.barFloor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matched for home calisthenics with a pull-up bar: upper/lower sessions four days a week."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Barfiks barıyla evde kalistenik için eşleştirildi: haftada dört gün üst/alt vücut seansı."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passend für Calisthenics zu Hause mit Klimmzugstange: vier Tage pro Woche Ober- und Unterkörper."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapté à la callisthénie à domicile avec une barre de traction : haut et bas du corps quatre jours par semaine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegido para calistenia en casa con barra de dominadas: torso y pierna cuatro días por semana."
          }
        }
      }
    },
    "onboarding.reason.essentials": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matched for two full-body gym sessions that practise every main movement pattern twice a week."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftada iki tüm vücut salon seansı için eşleştirildi: her ana hareket kalıbı haftada iki kez çalışılır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passend für zwei Ganzkörpereinheiten im Studio, die jedes wichtige Bewegungsmuster zweimal pro Woche üben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapté à deux séances corps entier en salle qui travaillent chaque mouvement principal deux fois par semaine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegido para dos sesiones de cuerpo completo en el gimnasio que practican cada patrón principal dos veces por semana."
          }
        }
      }
    },
    "onboarding.reason.machineFoundation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matched for machine and cable guidance with low joint impact and zero barbell setup required."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düşük eklem baskısı, serbest ağırlık kurulumu olmadan makinelerle güvenli antrenman için eşleştirildi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passend für geführtes Training an Maschinen und Kabelzügen mit geringer Gelenkbelastung und ganz ohne Langhantel-Aufbau."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapté à l’entraînement guidé sur machines et poulies, peu exigeant pour les articulations et sans installation de barre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegido para entrenar guiado con máquinas y poleas, con bajo impacto en las articulaciones y sin montar una barra."
          }
        }
      }
    },
    "onboarding.reason.classicPpl": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matched for 6 days of dedicated Push, Pull, and Legs training with high hypertrophy volume."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftada 6 gün adanmış İtiş, Çekiş ve Bacak hipertrofi hacmi için eşleştirildi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passend für 6 Tage gezieltes Push-, Pull- und Beintraining mit hohem Hypertrophievolumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapté à 6 jours d’entraînement push, pull et jambes avec un volume d’hypertrophie élevé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegido para 6 días de entrenamiento de empuje, tirón y piernas con alto volumen de hipertrofia."
          }
        }
      }
    },
    "onboarding.reason.aestheticHypertrophy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matched for 5-day balanced upper/lower physique development with extra shoulder focus."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 günlük dengeli üst/alt vücut gelişimi ve ekstra omuz vurgusu için eşleştirildi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passend für eine 5-tägige ausgewogene Entwicklung des Ober- und Unterkörpers mit besonderem Fokus auf die Schulter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapté à 5 jours de développement équilibré du haut et du bas du corps, avec un accent supplémentaire sur les épaules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegido para 5 días de desarrollo equilibrado de tren superior e inferior con énfasis extra en los hombros."
          }
        }
      }
    },
    "onboarding.reason.powerbuildingStrength": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matched for 4-day heavy compound progression (squat, bench, deadlift) paired with hypertrophy accessory work."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "4 günlük ağır temel kaldırışlar (squat, bench, deadlift) ve hipertrofi aksesuarları için eşleştirildi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passend für 4 Tage schwere Progression bei den Grundübungen (Kniebeuge, Bankdrücken, Kreuzheben) mit Hypertrophie-Zusatzübungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapté à 4 jours de progression lourde sur les mouvements de base (squat, développé couché, soulevé de terre) avec du travail d’hypertrophie complémentaire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegido para 4 días de progresión pesada en los básicos (sentadilla, press de banca, peso muerto) con trabajo accesorio de hipertrofia."
          }
        }
      }
    },
    "onboarding.reason.upperLower": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matched for 4-day upper/lower balance hitting each major muscle group twice a week with optimal recovery."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftada iki kez her kas grubunu çalıştıran 4 günlük dengeli Üst/Alt bölüşümü için eşleştirildi."
