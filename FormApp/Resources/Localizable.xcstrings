    "notice.storageFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save workout data. Your existing data has been kept. Check available storage and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenman verileri kaydedilemedi. Mevcut verileriniz korundu. Boş depolama alanını kontrol edip tekrar deneyin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trainingsdaten konnten nicht gespeichert werden. Vorhandene Daten bleiben erhalten. Prüfe den freien Speicher und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer les données d’entraînement. Les données existantes sont conservées. Vérifiez l’espace disponible et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar los datos del entrenamiento. Se conservaron los datos existentes. Comprueba el espacio disponible e inténtalo de nuevo."
