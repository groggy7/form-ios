    "matrix.info.overviewTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What This Matrix Shows"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Matris Ne Gösterir?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was diese Matrix zeigt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que montre cette matrice"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que muestra esta matriz"
          }
        }
      }
    },
    "matrix.info.overviewText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracks your weekly working sets across 14 muscle groups against benchmark volume targets. It provides a clear visual guide for muscle balance and workload—not a diagnosis of recovery or fatigue, which varies by sleep, nutrition, and experience."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "14 kas grubundaki haftalık çalışma setlerinizi genel kabul gören hacim hedefleriyle karşılaştırır. Hangi kasları ne kadar çalıştırdığınızı gösteren pratik bir rehberdir; toparlanma uykunuza ve beslenmenize de bağlı olduğundan tıbbi tanı niteliği taşımaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolgt Ihr wöchentliches Arbeitssätze über 14 Muskelgruppen im Vergleich zu Benchmark-Volumenzielen. Es bietet einen klaren visuellen Leitfaden für das Muskelgleichgewicht und die Arbeitsbelastung – keine Diagnose von Erholung oder Müdigkeit, die je nach Schlaf, Ernährung und Erfahrung variieren kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suit votre séries de travail hebdomadaire sur 14 groupes musculaires par rapport aux objectifs de volume de référence. Il fournit un guide visuel clair sur l'équilibre musculaire et la charge de travail, et non un diagnostic de récupération ou de fatigue, qui varie en fonction du sommeil, de la nutrition et de l'expérience."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Realiza un seguimiento de tu series efectivas semanal en 14 grupos de músculos frente a objetivos de volumen de referencia. Proporciona una guía visual clara para el equilibrio muscular y la carga de trabajo, no un diagnóstico de recuperación o fatiga, que varía según el sueño, la nutrición y la experiencia."
          }
        }
      }
    },
    "matrix.info.calculationTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How Volume is Counted"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacim Nasıl Hesaplanır?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie das Volumen gezählt wird"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment le volume est compté"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo se cuenta el volumen"
          }
        }
      }
    },
    "matrix.info.directSetsTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct Sets (1.0×)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrudan Setler (1.0×)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkt Sätze (1,0×)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct séries (1,0 ×)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Directo series (1,0×)"
          }
        }
      }
    },
    "matrix.info.directSetsDesc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Primary target muscles get full credit (1.0 set). For example, your chest receives full credit on a bench press."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harekette birincil çalışan kas tam puan (1,0 set) alır. Örneğin bench press yaparken göğüs kasınız tam set sayılır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Primäre Zielmuskeln erhalten die volle Punktzahl (1,0 Satz). Beispielsweise wird Ihre Brust beim Bankdrücken voll beansprucht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les muscles cibles principaux obtiennent l’intégralité du crédit (ensemble 1,0). Par exemple, votre poitrine reçoit tout le crédit lors d'un développé couché."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los músculos objetivo principales obtienen el crédito completo (1,0 series). Por ejemplo, tu pecho recibe todo el crédito en un press de banca."
          }
        }
      }
    },
    "matrix.info.indirectSetsTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Indirect Sets (0.5×)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolaylı Setler (0.5×)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Indirekt Sätze (0,5×)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indirect séries (0,5×)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indirecto series (0,5×)"
          }
        }
      }
    },
    "matrix.info.indirectSetsDesc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assisting muscles get half credit (0.5 set)—like your triceps and front shoulders supporting a bench press."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harekete yardımcı olan ikincil kaslar yarım puan (0,5 set) alır; bench press sırasında göğse destek olan arka kol ve ön omuz gibi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterstützende Muskeln erhalten die Hälfte (0,5 Sätze) – wie Ihr Trizeps und Ihre vorderen Schultern, die beim Bankdrücken unterstützen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les muscles auxiliaires obtiennent la moitié du crédit (0,5 set), comme vos triceps et vos épaules avant soutenant un développé couché."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los músculos auxiliares reciben la mitad del crédito (0,5 series), como los tríceps y los hombros delanteros que sostienen el press de banca."
          }
        }
      }
    },
