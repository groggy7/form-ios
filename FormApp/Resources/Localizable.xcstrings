    "form_lab.balance.ham_dominant_alert": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're logging more hamstring sets than quad sets."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ön bacağa kıyasla daha fazla arka bacak (hamstring) seti yapıyorsunuz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du protokollierst mehr Beinbeuger- als Quadrizepssätze."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous enregistrez plus de séries pour les ischio-jambiers que pour les quadriceps."
          }
