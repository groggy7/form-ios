    "settings.about": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About Forced Rep"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forced Rep hakkında"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über Forced Rep"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À propos de Forced Rep"
          }
