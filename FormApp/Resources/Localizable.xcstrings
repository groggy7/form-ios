      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup confirmed in iCloud Drive"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive yedeği doğrulandı"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicherung in iCloud Drive bestätigt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarde confirmée dans iCloud Drive"
          }
        },
