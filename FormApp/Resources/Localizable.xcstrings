            "state": "translated",
            "value": "Sumar repeticiones · Mantener el peso"
          }
        }
      }
    },
    "progression.action.hold_load": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Load · Build Consistency"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağırlığı Koru · Tutarlılığı Artır"
          }
        },
        "de": {
          "stringUnit": {
