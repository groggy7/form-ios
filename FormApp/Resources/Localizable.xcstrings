    "progression.action.deload": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progress Paused · Review Options"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlerleme Durdu · Seçenekleri Gözden Geçir"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortschritt pausiert · Optionen prüfen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Progression en pause · Options à examiner"
          }
        },
        "es": {
