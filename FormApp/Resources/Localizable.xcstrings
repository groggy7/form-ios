    "settings.exportDataDesc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a backup file to your device or share it to transfer your workouts to another phone or platform."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedek dosyasını cihazınıza kaydedin veya başka bir telefona/platforma aktarmak için paylaşın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern Sie eine Sicherungsdatei auf Ihrem Gerät oder teilen Sie sie, um Ihre Trainingseinheiten auf ein anderes Telefon oder eine andere Plattform zu übertragen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez un fichier de sauvegarde sur votre appareil ou partagez-le pour transférer vos entraînements vers un autre téléphone ou une autre plateforme."
          }
        },
        "es": {
