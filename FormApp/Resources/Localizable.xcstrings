    "form_lab.balance_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compares your logged sets across opposing movement patterns to keep your routine well-rounded, not as a clinical diagnosis of joint health."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenmanınızın dengeli ilerlemesini sağlamak için karşıt hareket setlerinizi karşılaştırır; eklem sağlığı veya tıbbi tanı niteliği taşımaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleicht deine protokollierten Sätze zwischen gegensätzlichen Bewegungsmustern, damit dein Training ausgewogen bleibt – keine klinische Diagnose der Gelenkgesundheit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare vos séries enregistrées entre des schémas de mouvement opposés pour garder un programme équilibré – ce n’est pas un diagnostic clinique de la santé articulaire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara tus series registradas entre patrones de movimiento opuestos para mantener una rutina equilibrada; no es un diagnóstico clínico de la salud articular."
          }
        }
      }
    },
