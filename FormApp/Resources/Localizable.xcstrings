    "progression.rationale.insufficient_data": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The latest log does not provide a complete baseline for this plan. Log all {sets} working sets with weights and reps."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son kayıt bu plan için tam bir başlangıç verisi sağlamıyor. {sets} çalışma setinin tümünde ağırlık ve tekrarları kaydet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzte Aufzeichnung bietet keine vollständige Grundlage für diesen Plan. Zeichne alle {sets} Arbeitssätze mit Gewicht und Wiederholungen auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dernier enregistrement ne fournit pas de référence complète pour ce plan. Enregistrez les {sets} séries de travail avec leurs charges et leurs répétitions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El último registro no proporciona una referencia completa para este plan. Registra las {sets} series efectivas con sus pesos y repeticiones."
          }
        }
      }
    },
    "progression.rationale.repeat_ceiling": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeat these weights for {ceiling} reps per set. Confirm the same result in another workout before adding weight."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ağırlıklarla her sette {ceiling} tekrarı tekrarla. Ağırlık artırmadan önce aynı sonucu bir antrenmanda daha doğrula."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederhole diese Gewichte mit {ceiling} Wiederholungen pro Satz. Bestätige das gleiche Ergebnis in einem weiteren Training, bevor du Gewicht erhöhst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répétez ces charges pour {ceiling} répétitions par série. Confirmez le même résultat lors d’un autre entraînement avant d’ajouter du poids."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repite estos pesos con {ceiling} repeticiones por serie. Confirma el mismo resultado en otro entrenamiento antes de añadir peso."
          }
        }
      }
    },
    "progression.rationale.load_step_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You reached the top of the rep range. Repeat the logged loads, or choose a small available increase yourself if manageable. No automatic load increase is offered for this baseline."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üst tekrar hedefine ulaştın. Kayıtlı ağırlıkları tekrarla veya uygunsa ekipmanında bulunan küçük bir artışı kendin seç. Bu başlangıç verisi için otomatik ağırlık artışı sunulmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast das obere Ende des Wiederholungsbereichs erreicht. Wiederhole die protokollierten Gewichte oder wähle selbst eine kleine verfügbare Steigerung, wenn machbar. Für diese Grundlage wird keine automatische Gewichtssteigerung angeboten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez atteint le haut de la plage de répétitions. Répétez les charges enregistrées ou choisissez vous-même une petite augmentation disponible si c’est gérable. Aucune augmentation automatique de charge n’est proposée pour cette référence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has llegado al tope del rango de repeticiones. Repite las cargas registradas o elige tú mismo un pequeño aumento disponible si es manejable. No se ofrece ningún aumento automático de carga para esta referencia."
          }
        }
      }
    },
    "progression.info.rules": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progression rules"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlerleme kuralları"
          }
        },
        "de": {
