    "today.restDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No workout is scheduled for today. You can still open any workout above."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün için planlanmış antrenman yok. Yukarıdan bir antrenman seçebilirsin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für heute ist kein Training geplant. Du kannst trotzdem jedes Training oben öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun entraînement n'est prévu aujourd'hui. Vous pouvez toujours ouvrir n’importe quel entraînement ci-dessus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún entrenamiento programado para hoy. Aún puedes abrir cualquier entrenamiento de arriba."
          }
        }
      }
    },
    "today.restMotivation.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Real progress is forged when recovery matches your effort. Sleep deeply, refuel to rebuild, and let your body adapt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerçek gelişim, toparlanma emeğinize denk olduğunda şekillenir. Derin uyuyun, onarım için beslenin ve vücudunuzun adapte olmasına izin verin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Echter Fortschritt entsteht, wenn die Erholung deiner Anstrengung entspricht. Schlaf tief, tank neue Energie und lass deinen Körper sich anpassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De véritables progrès se forgent lorsque la récupération est à la hauteur de vos efforts. Dormez profondément, faites le plein pour vous reconstruire et laissez votre corps s'adapter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El verdadero progreso se forja cuando la recuperación está a la altura de tu esfuerzo. Duerme profundamente, recarga energías para reconstruirte y deja que tu cuerpo se adapte."
          }
        }
      }
    },
    "today.restMotivation.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest is not the absence of training; it is the catalyst for growth. Give your muscles time to repair and supercompensate."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinlenme antrenmanın yokluğu değil, gelişimin katalizörüdür. Kaslarınıza onarılmaları ve güçlenmeleri için gereken zamanı tanıyın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhe ist nicht die Abwesenheit von Training; sie ist der Katalysator für Wachstum. Gib deinen Muskeln Zeit zur Reparatur und Superkompensation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le repos n’est pas l’absence d’entraînement ; c'est le catalyseur de la croissance. Donnez à vos muscles le temps de se réparer et de surcompenser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El descanso no es la ausencia de entrenamiento; es el catalizador del crecimiento. Dale tiempo a tus músculos para repararse y supercompensarse."
          }
        }
      }
    },
    "today.restMotivation.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Muscles rebuild during rest, not in the gym. Stepping back today ensures you bring full intensity to the bar tomorrow."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaslar salonda değil, dinlenirken inşa edilir. Bugün geri adım atmak, yarın ağırlığa tam yoğunlukla girmenizi sağlar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Muskeln bauen sich in der Ruhe auf, nicht im Studio. Wenn du heute einen Schritt zurücktrittst, gehst du morgen mit voller Intensität an die Hantel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les muscles se reconstruisent au repos, pas à la salle. Prendre du recul aujourd’hui vous permet d’apporter toute votre intensité à la barre demain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los músculos se reconstruyen durante el descanso, no en el gimnasio. Dar un paso atrás hoy garantiza que mañana traerás toda la intensidad a la barra."
          }
        }
      }
    },
    "today.restMotivation.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fatigue masks fitness. Allowing your central nervous system to reset is what turns hard volume into lasting strength."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorgunluk performansı perdeler. Merkezi sinir sisteminizin yenilenmesine izin vermek, ağır hacmi kalıcı güce dönüştürür."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermüdung verdeckt Fitness. Wenn sich dein zentrales Nervensystem erholen kann, wird aus hartem Volumen dauerhafte Kraft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fatigue masque la forme physique. Permettre à votre système nerveux central de se réinitialiser est ce qui transforme un volume dur en force durable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fatiga enmascara la forma física. Permitir que tu sistema nervioso central se recupere es lo que convierte el volumen intenso en fuerza duradera."
          }
        }
      }
    },
    "today.restMotivation.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consistency includes knowing when not to train. Quality rest prevents joint wear and fuels continuous progressive overload."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstikrar, ne zaman çalışmayacağını bilmeyi de kapsar. Kaliteli dinlenme eklem aşınmasını önler ve sürekli aşamalı yüklenmeyi besler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zur Beständigkeit gehört auch, zu wissen, wann man nicht trainiert. Gute Erholung schont die Gelenke und ermöglicht eine kontinuierliche progressive Überlastung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La régularité implique de savoir quand ne pas s’entraîner. Un repos de qualité limite l’usure des articulations et alimente une surcharge progressive continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La constancia incluye saber cuándo no entrenar. Un descanso de calidad previene el desgaste de las articulaciones y alimenta la sobrecarga progresiva continua."
          }
        }
      }
    },
    "today.restMotivation.5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptation happens in the quiet hours between sessions. Hydrate, recover, and prepare your body for the next challenge."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptasyon, seanslar arasındaki sessiz saatlerde gerçekleşir. Hidrasyonu koruyun, toparlanın ve vücudunuzu bir sonraki mücadeleye hazırlayın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anpassung erfolgt in den ruhigen Stunden zwischen den Einheiten. Trink genug, erhol dich und bereite deinen Körper auf die nächste Herausforderung vor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'adaptation se produit dans les heures calmes entre les séances. Hydratez-vous, récupérez et préparez votre corps au prochain défi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La adaptación ocurre en las horas tranquilas entre sesiones. Hidrátate, recupérate y prepara tu cuerpo para el próximo desafío."
          }
        }
      }
    },
    "today.restMotivation.6": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Growth occurs when recovery meets discipline. Recharge fully today so you can attack the upcoming training week with conviction."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyüme, toparlanma disiplinle buluştuğunda gerçekleşir. Yeni antrenman haftasına kararlılıkla başlamak için bugün enerjinizi tazeleyin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wachstum entsteht, wenn Erholung auf Disziplin trifft. Tank heute neue Energie, damit du voller Überzeugung in die kommende Trainingswoche startest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La croissance se produit lorsque la récupération rencontre la discipline. Rechargez complètement vos batteries aujourd’hui pour attaquer la prochaine semaine d’entraînement avec conviction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El crecimiento ocurre cuando la recuperación se encuentra con la disciplina. Recarga energías hoy para poder afrontar la próxima semana de entrenamiento con convicción."
          }
        }
      }
    },
