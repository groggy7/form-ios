    "form_lab.rep_max_matrix_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimates from 1–10 rep working sets, not tested maximums. Rep targets are estimates, not prescribed loads."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1–10 tekrarlı çalışma setlerinden tahminlerdir; ölçülmüş maksimumlar değildir. Tekrar hedefleri önerilen yükler değil, tahminlerdir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schätzungen aus Arbeitssätzen mit 1–10 Wiederholungen, keine getesteten Maxima. Wiederholungsziele sind Schätzungen, keine vorgegebenen Gewichte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimations à partir de séries de travail de 1 à 10 répétitions, pas de maximums testés. Les objectifs de répétitions sont des estimations, pas des charges prescrites."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimaciones a partir de series efectivas de 1–10 repeticiones, no de máximos comprobados. Los objetivos de repeticiones son estimaciones, no cargas prescritas."
          }
        }
      }
    },
