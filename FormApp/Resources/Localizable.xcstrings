    "paywall.volume_matrix.benefit4_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use logged-set trends as programming prompts, not measures of fatigue or recovery."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Set eğilimlerini programlama ipucu olarak kullanın; yorgunluk veya toparlanma ölçümü değildir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze die Entwicklung deiner protokollierten Sätze zur Trainingsplanung. Sie misst weder Ermüdung noch Erholung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez l’évolution des séries pour guider votre programme. Elle ne mesure ni la fatigue ni la récupération."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la evolución de tus series para orientar el programa. No mide la fatiga ni la recuperación."
          }
        }
      }
    },
