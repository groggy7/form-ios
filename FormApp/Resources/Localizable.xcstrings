    "errors.fileWrite": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to save this file. Check the destination and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya kaydedilemedi. Hedef konumu kontrol edip tekrar deneyin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei konnte nicht gespeichert werden. Prüfe den Zielort und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer ce fichier. Vérifiez le dossier de destination et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el archivo. Comprueba la ubicación de destino y vuelve a intentarlo."
          }
        }
      }
    },
    "errors.fileApply": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file could not be applied. Reopen it and review the preview before trying again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya uygulanamadı. Dosyayı yeniden açıp önizlemeyi kontrol ederek tekrar deneyin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei konnte nicht übernommen werden. Öffne sie erneut, prüfe die Vorschau und versuche es noch einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’appliquer ce fichier. Rouvrez-le, vérifiez l’aperçu et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo aplicar el archivo. Ábrelo de nuevo, revisa la vista previa e inténtalo otra vez."
          }
        }
      }
    },
