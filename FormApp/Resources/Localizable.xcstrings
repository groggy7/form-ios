          }
        }
      }
    },
    "progression.info.ddpTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How Dynamic Double Progression Works"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinamik Çift Aşamalı İlerleme Nasıl Çalışır?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So funktioniert die dynamische Doppelprogression"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment fonctionne la double progression dynamique"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo funciona la doble progresión dinámica"
          }
        }
      }
    },
    "progression.info.ddpText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Targets use your latest full session with this plan’s working-set count. Incomplete logs give no target. Warmups don’t count."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedefler, planla aynı sayıda çalışma seti içeren son tam antrenmanına dayanır. Eksik kayıtta hedef verilmez. Isınma setleri sayılmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziele verwenden Ihre letzte vollständige Sitzung mit der Arbeitssatzanzahl dieses Plans. Unvollständige Protokolle geben kein Ziel. Aufwärmübungen zählen nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cibles utilisent votre dernière session complète avec le nombre d’ensembles de travail de ce plan. Les journaux incomplets ne donnent aucune cible. Les échauffements ne comptent pas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los objetivos utilizan su última sesión completa con el recuento de conjuntos de trabajo de este plan. Los registros incompletos no dan ningún objetivo. Los calentamientos no cuentan."
          }
        }
      }
    },
    "progression.info.plateauTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Logged Progress Pauses"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı İlerleme Durduğunda"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der protokollierte Fortschritt pausiert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque la progression enregistrée s'interrompt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando el progreso registrado se detiene"
          }
        }
      }
    },
    "progression.info.plateauText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only full sessions with matching weights and set counts are compared. Below the rep ceiling, three without a total rep gain prompt a review. The app doesn’t measure fatigue, recovery or technique."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca ağırlıkları ve set sayıları aynı olan tam antrenmanlar karşılaştırılır. Üst tekrar sınırının altında üç antrenmanda toplam tekrar artmazsa planını gözden geçir. Uygulama yorgunluğu, toparlanmayı veya tekniği ölçmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden nur vollständige Sitzungen mit übereinstimmenden Gewichten und Satzzahlen verglichen. Unterhalb der Wiederholungsobergrenze führen drei ohne Gesamtwiederholungszuwachs zu einer Überprüfung. Die App misst weder Ermüdung, Erholung noch Technik."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les sessions complètes avec des poids et des décomptes correspondants sont comparées. En dessous du plafond de répétition, trois sans gain total de répétition entraînent une révision. L’application ne mesure pas la fatigue, la récupération ou la technique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sólo se comparan sesiones completas con pesos y recuentos de conjuntos coincidentes. Por debajo del límite de repeticiones, tres sin una ganancia total de repeticiones solicitan una revisión. La aplicación no mide la fatiga, la recuperación ni la técnica."
          }
        }
      }
    },
    "progression.info.tipTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach Tip"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koç İpucu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trainer-Tipp"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conseil de l'entraîneur"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo del entrenador"
          }
        }
      }
    },
    "progression.info.tipText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow your goals and how training feels. Logs don’t require a fixed deload schedule. A lighter week doesn’t guarantee progress or injury prevention."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedeflerini ve antrenmanda nasıl hissettiğini dikkate al. Kayıtlar sabit bir deload takvimi gerektirmez. Hafif bir hafta ilerlemeyi veya sakatlıkların önlenmesini garanti etmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolgen Sie Ihre Ziele und wie sich das Training anfühlt. Für Protokolle ist kein fester Ladeplan erforderlich. Eine leichtere Woche ist keine Garantie für Fortschritte oder Verletzungsprävention."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez vos objectifs et comment vous vous sentez à l'entraînement. Les journaux ne nécessitent pas de calendrier de téléchargement fixe. Une semaine plus légère ne garantit pas de progrès ni de prévention des blessures."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue tus objetivos y cómo se siente entrenar. Los registros no requieren un programa de descarga fijo. Una semana más ligera no garantiza progreso ni prevención de lesiones."
          }
        }
      }
    },
