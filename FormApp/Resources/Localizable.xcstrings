    "matrix.cycleNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per program cycle: each workout is counted once, not according to your weekly schedule. Weekly reference ratings are not applied."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Program döngüsü başına: her antrenman bir kez sayılır; haftalık takviminiz kullanılmaz. Haftalık referans değerlendirmesi uygulanmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro Programmzyklus: Jedes Training wird einmal gezählt, nicht gemäß Ihrem Wochenplan. Wöchentliche Referenzbewertungen werden nicht angewendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par cycle de programme : chaque entraînement est compté une fois, et non selon votre programme hebdomadaire. Les notations de référence hebdomadaires ne sont pas appliquées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ciclo de programa: cada entrenamiento se cuenta una vez, no según su horario semanal. No se aplican calificaciones de referencia semanales."
          }
        }
      }
    },
    "matrix.creditNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each working set counts once. Primary muscles get 1.0 credit and assisting muscles get 0.5, reflecting how compound lifts work multiple areas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her çalışma seti bir kez sayılır. Birleşik egzersizlerin tüm etkisini görebilmeniz için ana kaslar 1,0, destekleyici kaslar 0,5 katkı alır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Arbeitssatz zählt einmal. Primäre Muskeln erhalten 1,0 Punkte und unterstützende Muskeln 0,5 Punkte, was widerspiegelt, wie zusammengesetzte Übungen mehrere Bereiche beanspruchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque série de travail compte une fois. Les muscles primaires obtiennent 1,0 crédit et les muscles auxiliaires 0,5, reflétant la façon dont les ascenseurs composés travaillent sur plusieurs domaines."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada serie efectiva cuenta una vez. Los músculos primarios obtienen 1,0 crédito y los músculos auxiliares obtienen 0,5, lo que refleja cómo los levantamientos compuestos trabajan en múltiples áreas."
          }
        }
      }
    },
