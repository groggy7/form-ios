    "matrix.zone.over_mrv_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Well above usual targets. Consider giving this muscle group extra recovery."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedef aralığın oldukça üzerinde. Bu kas grubuna ekstra dinlenme tanımayı düşünebilirsiniz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deutlich über den üblichen Zielen. Erwägen Sie, dieser Muskelgruppe zusätzliche Erholung zu gönnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bien au-dessus des objectifs habituels. Pensez à donner à ce groupe musculaire une récupération supplémentaire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muy por encima de los objetivos habituales. Considere darle a este grupo de músculos una recuperación adicional."
          }
        }
      }
    },
