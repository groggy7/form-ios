    "pro.custom_themes.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalize Forced Rep with bespoke dark color themes including Espresso & Beige, Monochrome Stealth, Midnight Cobalt, and more."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forced Rep uygulamasını Espresso & Bej, Monokrom Stealth, Gece Yarısı Kobalt ve daha fazla özel koyu temayla kişiselleştirin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe Forced Rep mit maßgeschneiderten dunklen Themes an, darunter Espresso & Beige, Monochrom Stealth, Mitternachts-Kobalt und mehr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personnalisez Forced Rep avec des thèmes sombres sur mesure, notamment Espresso & Beige, Monochrome Stealth, Cobalt Minuit et plus encore."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Personaliza Forced Rep con temas oscuros a medida, incluyendo Espresso & Beige, Monocromo Stealth, Cobalto Medianoche y más."
          }
        }
      }
    },
