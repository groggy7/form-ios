    "builder.conflictDraftMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This saved draft is based on an earlier version. Keep it as a new program, or discard the draft to edit the current version."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu taslak önceki bir sürüme dayanıyor. Yeni program olarak saklayın veya güncel sürümü düzenlemek için taslağı silin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Entwurf basiert auf einer früheren Version. Behalte ihn als neues Programm oder verwirf ihn, um die aktuelle Version zu bearbeiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce brouillon repose sur une version antérieure. Conservez-le comme nouveau programme ou abandonnez-le pour modifier la version actuelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este borrador se basa en una versión anterior. Consérvalo como programa nuevo o descártalo para editar la versión actual."
          }
        }
      }
    },
