    "form_lab.mirror_privacy_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your backup is stored in a private app-data area and isn’t visible among your normal Drive files."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedeğiniz özel bir uygulama verisi alanında saklanır ve normal Drive dosyalarınız arasında görünmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Backup wird in einem privaten App-Datenbereich gespeichert und ist in Ihren normalen Drive-Dateien nicht sichtbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre sauvegarde est stockée dans une zone de données d'application privée et n'est pas visible parmi vos fichiers Drive normaux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su copia de seguridad se almacena en un área privada de datos de la aplicación y no es visible entre sus archivos normales de Drive."
          }
        }
      }
    },
