    "paywall.form_lab.benefit3_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare push/pull, quads/hamstrings and upper/lower body work from logged sets."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı setlerde itiş/çekiş, ön/arka bacak ve üst/alt vücut çalışmasını karşılaştır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche Drücken und Ziehen, Quadrizeps und Beinbeuger sowie Ober- und Unterkörper anhand deiner protokollierten Sätze."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparez poussée et tirage, quadriceps et ischio-jambiers, ainsi que haut et bas du corps à partir des séries enregistrées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara empuje y tirón, cuádriceps e isquiotibiales y tren superior e inferior a partir de tus series registradas."
          }
        }
      }
    },
    "paywall.form_lab.reference_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimates use 1–10 rep working sets. Distribution compares set allocation."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahminler 1–10 tekrarlı çalışma setlerine dayanır. Dağılım, setlerin payını karşılaştırır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schätzungen beruhen auf Arbeitssätzen mit 1–10 Wiederholungen. Die Verteilung vergleicht die Zuordnung der Sätze."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les estimations utilisent des séries de travail de 1 à 10 répétitions. La répartition compare l’attribution des séries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las estimaciones usan series efectivas de 1 a 10 repeticiones. La distribución compara el reparto de series."
          }
        }
      }
    },
