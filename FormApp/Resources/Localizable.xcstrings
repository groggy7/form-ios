    "matrix.zone.high_fatigue_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Above standard target. Good for focus phases, but keep an eye on fatigue."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedef aralığın üzerinde. Odak dönemleri için etkilidir, yorgunluğunuzu takip edin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über dem Standardziel. Gut für Konzentrationsphasen, aber achten Sie auf Ermüdung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au-dessus de l'objectif standard. Bon pour les phases de concentration, mais gardez un œil sur la fatigue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por encima del objetivo estándar. Bueno para las fases de concentración, pero ojo con la fatiga."
          }
        }
      }
    },
    "matrix.zone.over_mrv": {
