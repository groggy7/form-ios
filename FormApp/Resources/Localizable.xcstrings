    "paywall.cloud_backup.benefit1_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a local copy and write to iCloud Drive when available. iCloud handles upload."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kopya cihazına, varsa iCloud Drive'a kaydedilir. Yüklemeyi iCloud yönetir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kopie bleibt lokal. Wenn iCloud Drive verfügbar ist, wird eine weitere in deinem privaten Bereich gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une copie reste sur l’appareil. Une autre est enregistrée dans votre espace privé si iCloud Drive est disponible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia permanece en el dispositivo. Si iCloud Drive está disponible, se guarda otra en tu espacio privado."
          }
        }
      }
    },
    "paywall.cloud_backup.benefit2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Forced Rep Account"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forced Rep Hesabı Gerekmez"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Forced Rep-Konto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de compte Forced Rep"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta Forced Rep"
          }
        }
      }
    },
    "paywall.cloud_backup.benefit2_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive uses your Apple account, without a separate Forced Rep sign-up."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive, ayrı bir Forced Rep hesabı gerekmeden Apple hesabını kullanır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze deinen bestehenden Apple-Account ohne zusätzliche Registrierung bei Forced Rep."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez votre compte Apple existant sans inscription supplémentaire à Forced Rep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa tu cuenta de Apple sin registrarte por separado en Forced Rep."
          }
        }
      }
    },
    "paywall.cloud_backup.benefit3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After Every Workout"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her Antrenmandan Sonra"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach jedem Training"
          }
        },
        "fr": {
