    "paywall.auto_progression.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your saved sets to get personalized weight and rep targets with a clear reason for each suggestion."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydettiğin setlerden sana özel ağırlık ve tekrar hedefleri al. Her önerinin nedenini açıkça gör."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte aus deinen gespeicherten Sätzen passende Gewichts- und Wiederholungsziele mit einer klaren Begründung für jeden Vorschlag."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenez des objectifs de charge et de répétitions à partir de vos séries enregistrées, avec une explication claire pour chaque suggestion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtén objetivos de peso y repeticiones a partir de tus series registradas, con una explicación clara para cada sugerencia."
          }
        }
      }
    },
