    "onboarding.frequency.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many days can you train?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftada kaç gün antrenman yapabilirsiniz?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viele Tage kannst du trainieren?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de jours pouvez-vous vous entraîner ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuántos días puedes entrenar?"
          }
        }
      }
    },
    "onboarding.frequency.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consistency matters more than cramming too many days."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süreklilik, çok fazla günü zorlamaktan her zaman daha etkilidir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regelmäßigkeit zählt mehr als möglichst viele Tage."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La régularité compte plus que d’accumuler trop de jours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La constancia importa más que entrenar demasiados días."
          }
        }
      }
    },
    "onboarding.frequency.days2.title": {
