    "programs.deleteHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes the program and its workouts. Past workout history is kept. Export it first if you want a copy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Program ve antrenmanları silinir. Geçmiş antrenman kayıtları korunur. Bir kopya istersen önce dışa aktar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden das Programm und seine Trainings gelöscht. Der bisherige Trainingsverlauf bleibt erhalten. Exportiere es zuerst, wenn du eine Kopie möchtest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime le programme et ses entraînements. L’historique des entraînements passés est conservé. Exportez-le d’abord si vous souhaitez une copie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina el programa y sus entrenamientos. Se conserva el historial de entrenamientos anteriores. Expórtalo primero si quieres una copia."
          }
        }
      }
    },
    "programs.defaultRestHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for new exercises and imports without restSeconds. Existing exercises keep their saved rest. 0 skips the timer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni egzersizlerde ve restSeconds içermeyen dosyalarda kullanılır. Mevcut egzersizlerin süresi değişmez. 0, sayacı atlar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird für neue Übungen und Importe ohne restSeconds verwendet. Bestehende Übungen behalten ihre gespeicherte Pause. 0 überspringt den Timer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé pour les nouveaux exercices et les importations sans restSeconds. Les exercices existants conservent leur repos enregistré. 0 désactive le minuteur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para ejercicios nuevos e importaciones sin restSeconds. Los ejercicios existentes mantienen su descanso guardado. 0 omite el temporizador."
          }
        }
      }
    },
