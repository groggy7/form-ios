          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous faites beaucoup plus de travail sur le haut du corps que sur le bas du corps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás haciendo mucho más trabajo en la parte superior del cuerpo que en la parte inferior."
          }
        }
      }
    },
    "form_lab.balance.lower_dominant_alert": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're doing more lower-body than upper-body work."
