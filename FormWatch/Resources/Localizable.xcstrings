    "watch.locked.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Apple Watch app is part of Forced Rep Premium. Unlock it in Forced Rep on your iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch uygulaması Forced Rep Premium'a dahil. iPhone'undaki Forced Rep'ten kilidini aç."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Apple Watch-App gehört zu Forced Rep Premium. Schalte sie in Forced Rep auf deinem iPhone frei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app Apple Watch fait partie de Forced Rep Premium. Débloquez-la dans Forced Rep sur votre iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app de Apple Watch forma parte de Forced Rep Premium. Desbloquéala en Forced Rep en tu iPhone."
          }
        }
      }
    },
    "watch.update.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update Forced Rep on your watch to follow this workout."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu antrenmanı takip etmek için saatindeki Forced Rep'i güncelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiere Forced Rep auf deiner Watch, um diesem Training zu folgen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour Forced Rep sur votre montre pour suivre cet entraînement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza Forced Rep en tu reloj para seguir este entrenamiento."
          }
        }
      }
    },
