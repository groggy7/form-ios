    "watch.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone out of reach. Sets sync when it is back."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone erişim dışında. Setler geri geldiğinde eşitlenir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone nicht erreichbar. Sätze werden synchronisiert, sobald es wieder da ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone hors de portée. Les séries se synchroniseront à son retour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone fuera de alcance. Las series se sincronizan cuando vuelva."
          }
        }
      }
