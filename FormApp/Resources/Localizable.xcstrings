    "form_lab.info_cloud_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private Cloud Safety Mirror"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel Bulut Yedekleme"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Private Cloud-Sicherheitsspiegel"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miroir de sécurité du cloud privé"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espejo de seguridad en la nube privada"
          }
        }
      }
    },
    "form_lab.info_cloud_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves a local copy of your programs and history. When iCloud Drive is available, writes a copy to your private container; iCloud controls off-device upload."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Programlarınızın ve geçmişinizin yerel kopyasını kaydeder. iCloud Drive kullanılabiliyorsa özel alanınıza da kopyalar; cihaz dışı yüklemeyi iCloud yönetir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert eine lokale Kopie deiner Programme und deines Verlaufs. Wenn iCloud Drive verfügbar ist, wird eine Kopie in deinen privaten Container geschrieben. iCloud steuert den Upload außerhalb des Geräts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre une copie locale de vos programmes et de votre historique. Lorsque iCloud Drive est disponible, une copie est écrite dans votre conteneur privé ; iCloud gère l’envoi hors de l’appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda una copia local de tus programas e historial. Cuando iCloud Drive está disponible, escribe una copia en tu contenedor privado; iCloud gestiona la subida fuera del dispositivo."
          }
        }
      }
    },
