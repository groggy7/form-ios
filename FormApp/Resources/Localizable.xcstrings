    "form_lab.info_antagonist_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Movement & Muscle Balance"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hareket ve Kas Dengesi"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegung und Muskelbalance"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouvement et équilibre musculaire"
          }
