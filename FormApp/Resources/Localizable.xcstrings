    "form_lab.balance.upper_lower_optimal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upper and lower body training volume is well-proportioned."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üst ve alt vücut antrenman hacminiz gayet dengeli dağılmış."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Trainingsvolumen für Ober- und Unterkörper ist gut proportioniert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le volume d’entraînement du haut et du bas du corps est bien proportionné."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El volumen de entrenamiento de la parte superior e inferior del cuerpo está bien proporcionado."
          }
        }
      }
    },
    "form_lab.balance.upper_dominant_rec": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If full-body development is your goal, don't forget to give your legs some love."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm vücudun dengeli gelişmesini istiyorsanız bacak antrenmanlarınızı ihmal etmeyin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die Entwicklung des gesamten Körpers Ihr Ziel ist, vergessen Sie nicht, Ihren Beinen etwas Liebe zu schenken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si votre objectif est le développement de tout votre corps, n’oubliez pas de donner un peu d’amour à vos jambes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si su objetivo es el desarrollo de todo el cuerpo, no olvide darle un poco de amor a sus piernas."
          }
        }
      }
    },
    "form_lab.balance.lower_dominant_rec": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consider adding more upper-body work if you want an even distribution across the whole body."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm vücutta eşit bir dağılım istiyorsanız üst vücut hareketlerinizi artırmayı düşünebilirsiniz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie eine gleichmäßige Verteilung auf den gesamten Körper wünschen, sollten Sie über mehr Oberkörpertraining nachdenken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensez à ajouter davantage de travail sur le haut du corps si vous souhaitez une répartition uniforme sur tout le corps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Considere agregar más trabajo en la parte superior del cuerpo si desea una distribución uniforme en todo el cuerpo."
          }
        }
      }
    },
    "form_lab.balance.upper_lower_optimal_rec": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your routine distributes work evenly between upper and lower body."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Programınız iş yükünü üst ve alt vücut arasında eşit şekilde paylaştırıyor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Routine verteilt die Arbeit gleichmäßig auf Ober- und Unterkörper."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre routine répartit le travail uniformément entre le haut et le bas du corps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu rutina distribuye el trabajo de manera uniforme entre la parte superior e inferior del cuerpo."
          }
        }
      }
    },
    "form_lab.balance.more_data_needed": {
      "extractionState": "manual",
      "localizations": {
