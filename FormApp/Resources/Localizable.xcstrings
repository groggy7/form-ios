    "paywall.cloud_backup.benefit3_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With auto-sync on, workouts save locally and to iCloud Drive when available."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik eşitleme açıksa antrenmanlar cihazına, varsa iCloud Drive'a kaydedilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei automatischer Synchronisierung werden Trainings lokal gespeichert. iCloud übernimmt die Übertragung außerhalb des Geräts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation automatique enregistre les séances localement. iCloud gère leur transfert hors de l’appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización automática guarda las sesiones localmente. iCloud gestiona la subida fuera del dispositivo."
          }
        }
      }
    },
