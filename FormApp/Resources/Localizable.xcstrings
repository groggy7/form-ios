    "matrix.cycleNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per program cycle: each workout is counted once, not according to your weekly schedule. Weekly reference ratings are not applied."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Program döngüsü başına: her antrenman bir kez sayılır; haftalık takviminiz kullanılmaz. Haftalık referans değerlendirmesi uygulanmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro Programmzyklus: Jedes Training wird einmal gezählt, nicht gemäß deinem Wochenplan. Wöchentliche Referenzbewertungen werden nicht angewendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par cycle de programme : chaque entraînement est compté une fois, et non selon votre programme hebdomadaire. Les notations de référence hebdomadaires ne sont pas appliquées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ciclo de programa: cada entrenamiento se cuenta una vez, no según tu calendario semanal. No se aplican las valoraciones de referencia semanales."
          }
        }
      }
    },
    "matrix.noMuscleReference": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No published weekly reference range covers this region. Sets are counted, but not rated."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bölge için yayımlanmış haftalık referans aralığı yok. Setler sayılır ama değerlendirilmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Region gibt es keinen veröffentlichten wöchentlichen Referenzbereich. Sätze werden gezählt, aber nicht bewertet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune plage de référence hebdomadaire publiée ne couvre cette zone. Les séries sont comptées, mais pas évaluées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay un rango de referencia semanal publicado para esta zona. Las series se cuentan, pero no se valoran."
          }
        }
      }
    },
    "matrix.creditNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each working set counts once. Primary muscles get 1.0 credit and assisting muscles get 0.5, reflecting how compound lifts work multiple areas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her çalışma seti bir kez sayılır. Birleşik egzersizlerin tüm etkisini görebilmeniz için ana kaslar 1,0, destekleyici kaslar 0,5 katkı alır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Arbeitssatz zählt einmal. Hauptmuskeln werden mit 1,0 und unterstützende Muskeln mit 0,5 gewichtet, da Mehrgelenksübungen mehrere Bereiche beanspruchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque série de travail compte une fois. Les muscles principaux sont comptabilisés avec un coefficient de 1,0 et les muscles secondaires avec 0,5, car les exercices polyarticulaires sollicitent plusieurs zones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada serie efectiva cuenta una vez. Los músculos principales se contabilizan con un coeficiente de 1,0 y los secundarios con 0,5, ya que los ejercicios multiarticulares trabajan varias zonas."
          }
        }
      }
    },
