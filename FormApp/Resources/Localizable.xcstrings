            "state": "translated",
            "value": "Construir repeticiones · Manténgase en peso"
          }
        }
      }
    },
    "progression.action.hold_load": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Load · Build Consistency"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağırlığı Koru · Tutarlılığı Artır"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
