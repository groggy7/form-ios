    "form_lab.no_weighted_sets": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No eligible 1–10 rep working sets in this selection. Higher-rep sets remain in your history."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu seçimde uygun 1–10 tekrarlı çalışma seti yok. Daha yüksek tekrarlı setler geçmişinizde korunur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine geeigneten Arbeitssätze mit 1–10 Wiederholungen in dieser Auswahl. Sätze mit mehr Wiederholungen bleiben im Verlauf erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune série de travail admissible de 1 à 10 répétitions dans cette sélection. Les séries à plus de répétitions restent dans votre historique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay series efectivas válidas de 1–10 repeticiones en esta selección. Las series de más repeticiones siguen en tu historial."
          }
        }
      }
    },
    "form_lab.estimate_policy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated from logged working sets of 1–10 reps. Sets stopped with reps in reserve do not establish your maximum capacity."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen 1–10 tekrarlı çalışma setlerinden tahmin edilir. Tekrar rezerviyle bitirilen setler maksimum kapasiteni göstermez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschätzt anhand aufgezeichneter Arbeitssätze mit 1–10 Wiederholungen. Sätze mit Wiederholungen in Reserve belegen deine maximale Leistungsfähigkeit nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimation à partir des séries de travail enregistrées de 1 à 10 répétitions. Les séries terminées avec des répétitions en réserve ne permettent pas d’établir votre capacité maximale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimación a partir de series efectivas registradas de 1–10 repeticiones. Las series terminadas con repeticiones en reserva no determinan tu capacidad máxima."
          }
        }
      }
    },
