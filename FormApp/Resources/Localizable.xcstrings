          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana sayfadaki gün kutularında neon kenar parlaması ve köşe vurguları. Kapalıyken daha sakin cam görünümü kullanılır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neon-Randleuchten und Eckenglanz auf den Tageskacheln der Startseite. Aus: ruhigere Glasoptik."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Halo néon sur les bords et reflets dans les coins des tuiles de jour de l’accueil. Désactivé : verre plus sobre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resplandor neón en los bordes y brillos en las esquinas de las casillas de día de Inicio. Desactivado: cristal más sobrio."
          }
        }
      }
    },
