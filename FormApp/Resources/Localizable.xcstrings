    "form_lab.balance.push_dominant_alert": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're logging more push sets than pull sets."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çekişe kıyasla daha fazla itiş seti yapıyorsunuz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du protokollierst mehr Drück- als Zugsätze."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous enregistrez plus de séries de poussée que de tirage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás registrando más series de empuje que de tirón."
          }
        }
      }
    },
    "form_lab.balance.pull_dominant_alert": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're logging more pull sets than push sets."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İtişe kıyasla daha fazla çekiş seti yapıyorsunuz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du protokollierst mehr Zug- als Drücksätze."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous enregistrez plus de séries de tirage que de poussée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás registrando más series de tirón que de empuje."
          }
        }
      }
    },
    "form_lab.balance.push_pull_optimal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push and pull sets are well-balanced. Great for well-rounded shoulder and upper back work."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İtiş ve çekiş setleri gayet dengeli. Omuz ve sırt gelişimi için ideal bir uyum."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drück- und Zugsätze sind ausgewogen. Ideal für vielseitiges Schulter- und oberes Rückentraining."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les séries de poussée et de tirage sont bien équilibrées. Idéal pour un travail complet des épaules et du haut du dos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las series de empuje y tirón están bien equilibradas. Ideal para un trabajo completo de hombros y espalda alta."
          }
        }
      }
    },
    "form_lab.balance.push_dominant_rec": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consider adding a few more rowing or pull-up sets to keep your upper body balanced."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üst vücut dengesini korumak için programınıza birkaç set kürek (row) veya barfiks eklemeyi düşünebilirsiniz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erwäge ein paar zusätzliche Ruder- oder Klimmzugsätze, damit dein Oberkörper ausgewogen bleibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensez à ajouter quelques séries de rowing ou de tractions pour garder le haut du corps équilibré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Considera añadir algunas series más de remo o dominadas para mantener equilibrado el tren superior."
          }
        }
      }
    },
    "form_lab.balance.pull_dominant_rec": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensure your bench or overhead pressing gets enough attention if overall balance is your goal."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengeli bir gelişim hedefliyorsanız bench press ve omuz presi gibi itiş hareketlerinizi ihmal etmeyin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achte darauf, dass Bank- oder Überkopfdrücken genug Aufmerksamkeit bekommt, wenn ein ausgewogenes Training dein Ziel ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assurez-vous que le développé couché ou le développé militaire reçoit suffisamment d’attention si l’équilibre général est votre objectif."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que el press de banca o el press por encima de la cabeza reciban suficiente atención si buscas un equilibrio general."
          }
        }
      }
    },
    "form_lab.balance.push_pull_optimal_rec": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue with your current routine—your pushing and pulling volume is in a great spot."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut programınızla devam edin; itiş ve çekiş hacminiz gayet iyi bir dengede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach mit deiner aktuellen Routine weiter – dein Drück- und Zugvolumen ist sehr gut verteilt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez votre routine actuelle : votre volume de poussée et de tirage est bien réparti."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue con tu rutina actual: tu volumen de empuje y tirón está muy bien repartido."
          }
        }
      }
    },
    "form_lab.balance.quad_ham_title": {
