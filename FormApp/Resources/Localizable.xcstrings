          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez un fichier de sauvegarde sur votre appareil ou partagez-le pour transférer vos entraînements vers un autre téléphone ou une autre plateforme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda un archivo de copia de seguridad en tu dispositivo o compártelo para pasar tus entrenamientos a otro teléfono o plataforma."
          }
        }
      }
