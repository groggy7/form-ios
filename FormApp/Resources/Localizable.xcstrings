    "matrix.info.zoneUnderMevDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Below baseline targets. Good for a planned deload or active rest, though you may want more sets here if this muscle is a growth priority."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temel hacim eşiğinin altında. Hafif (deload) haftalar veya dinlenme için uygundur; bu kası büyütmek istiyorsanız birkaç set daha ekleyebilirsiniz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter den Grundzielen. Gut für eine geplante Entlastung oder eine aktive Erholung, obwohl Sie hier möglicherweise mehr Sätze wünschen, wenn dieser Muskel eine Wachstumspriorität hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En dessous des objectifs de référence. Bon pour une décharge planifiée ou un repos actif, même si vous voudrez peut-être plus de séries ici si ce muscle est une priorité de croissance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por debajo de los objetivos de referencia. Bueno para una descarga planificada o un descanso activo, aunque es posible que desees más series aquí si este músculo es una prioridad de crecimiento."
          }
        }
      }
    },
    "matrix.info.zoneProgressiveDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steady building zone. A solid amount of work that stimulates progress without piling on excessive fatigue."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenli gelişim aralığı. Aşırı yormadan kas gelişimini tetikleyen dengeli bir çalışma hacmi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabile Bauzone. Eine solide Menge Arbeit, die den Fortschritt anregt, ohne übermäßige Ermüdung hervorzurufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zone de construction stable. Un travail solide qui stimule la progression sans entraîner une fatigue excessive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Zona de construcción estable. Una cantidad sólida de trabajo que estimula el progreso sin acumular una fatiga excesiva."
          }
        }
      }
    },
    "matrix.info.zoneOptimalMavDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sweet spot for most lifters. This range typically drives the best balance of muscle gains and manageable recovery."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En verimli hacim aralığı. Çoğu sporcu için kas gelişimini en iyi destekleyen ve toparlanması ideal olan hedef bölgedir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sweet Spot für die meisten Lifter. Dieser Bereich sorgt normalerweise für die beste Balance zwischen Muskelzuwachs und beherrschbarer Erholung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'endroit idéal pour la plupart des haltérophiles. Cette gamme génère généralement le meilleur équilibre entre gains musculaires et récupération gérable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El punto óptimo para la mayoría de los levantadores. Este rango generalmente genera el mejor equilibrio entre ganancias musculares y una recuperación manejable."
          }
        }
      }
    },
    "matrix.info.zoneHighFatigueDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High workload zone. Pushes muscles hard for short focus blocks, but watch your recovery and sleep if you stay here long."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüksek çalışma hacmi. Odaklandığınız kasları zorlamak için iyidir; ancak uzun süre bu aralıkta kalırsanız toparlanmanıza ve uykunuza dikkat edin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zone mit hoher Arbeitsbelastung. Beansprucht die Muskeln stark für kurze Konzentrationsblockaden, aber achten Sie auf Ihre Erholung und Ihren Schlaf, wenn Sie lange hier bleiben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zone à forte charge de travail. Pousse fortement les muscles pendant de courts blocs de concentration, mais surveillez votre récupération et dormez si vous restez ici longtemps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Zona de alta carga de trabajo. Empuja los músculos con fuerza durante bloques cortos de concentración, pero observe su recuperación y duerma si permanece aquí por mucho tiempo."
          }
        }
      }
    },
    "matrix.info.zoneOverMrvDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Very high volume. Sets beyond this point often add more soreness than progress. Consider dialing back or taking a lighter week soon."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok yüksek hacim. Bu seviyenin üzerindeki setler genellikle gelişime katkı sağlamaktan çok yorgunluk biriktirir; yakında hafif bir hafta planlayabilirsiniz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehr hohe Lautstärke. Sätze über diesen Punkt hinaus verursachen oft mehr Schmerzen als Fortschritte. Denken Sie darüber nach, bald zurückzurufen oder sich eine leichtere Woche zu gönnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume très élevé. Au-delà de ce point, cela ajoute souvent plus de douleur que de progrès. Pensez à rappeler ou à prendre bientôt une semaine plus légère."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumen muy alto. series más allá de este punto suele añadir más dolor que progreso. Considere volver a marcar o tomar una semana más ligera pronto."
          }
        }
      }
    },
    "matrix.info.tipTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Training Tip"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenman İpucu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trainingstipp"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conseil de entraînement"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo de entrenamiento"
          }
        }
      }
    },
    "matrix.info.tipText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use these ranges as a flexible guide alongside how your body actually feels. If an ongoing week is below target or a priority muscle is in the high zone, adjust based on your energy and goals, not just to match colors."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aralıkları vücudunuzun nasıl hissettiğine göre esnek bir rehber olarak kullanın. Devam eden bir hafta geride görünebilir veya öncelikli bir kasınız yüksek bölgede olabilir; kararlarınızı yalnızca renkleri tutturmak için değil, hedeflerinize ve enerjinize göre verin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzen Sie diese Bereiche als flexiblen Anhaltspunkt dafür, wie sich Ihr Körper tatsächlich anfühlt. Wenn eine laufende Woche unter dem Zielwert liegt oder sich ein vorrangiger Muskel im Hochbereich befindet, passen Sie die Leistung basierend auf Ihrer Energie und Ihren Zielen an und nicht nur, um die Farben anzupassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez ces plages comme guide flexible en fonction de la façon dont votre corps se sent réellement. Si une semaine en cours est inférieure à l'objectif ou si un muscle prioritaire se trouve dans la zone haute, ajustez en fonction de votre énergie et de vos objectifs, pas seulement pour faire correspondre les couleurs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice estos rangos como una guía flexible junto con cómo se siente realmente su cuerpo. Si una semana en curso está por debajo del objetivo o un músculo prioritario está en la zona alta, ajústelo según su energía y sus objetivos, no solo para combinar colores."
          }
        }
      }
    },
    "pro.volume_matrix.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Biomechanical Volume Matrix"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biyomekanik Hacim Matrisi"
          }
        },
