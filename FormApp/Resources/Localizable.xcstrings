        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep IDs unchanged when editing an exported file. A different program ID creates a new program."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyayı düzenlerken kimlikleri değiştirme. Farklı program kimliği yeni bir program oluşturur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte die IDs beim Bearbeiten einer exportierten Datei bei. Eine andere Programm-ID erstellt ein neues Programm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez les identifiants inchangés lors de la modification d’un fichier exporté. Un ID de programme différent crée un nouveau programme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén los ID sin cambios al editar un archivo exportado. Un ID de programa distinto crea un programa nuevo."
          }
