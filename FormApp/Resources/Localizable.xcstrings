    "form_lab.mirror_discovery_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not check iCloud backups. Check your connection and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud yedekleri kontrol edilemedi. Bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-Backups konnten nicht überprüft werden. Überprüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier les sauvegardes iCloud. Vérifiez votre connexion et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron verificar las copias de seguridad de iCloud. Comprueba tu conexión y vuelve a intentarlo."
          }
        }
      }
    },
    "form_lab.mirror_download_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iCloud backup could not finish downloading. Check your connection and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud yedeği indirilemedi. Bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download des iCloud-Backups konnte nicht abgeschlossen werden. Überprüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde iCloud n'a pas pu terminer le téléchargement. Vérifiez votre connexion et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia de seguridad de iCloud no pudo terminar de descargarse. Comprueba tu conexión y vuelve a intentarlo."
          }
        }
      }
    },
    "form_lab.mirror_account_changed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple account changed. Use Sync Now to back up this device to the current account."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hesabınız değişti. Bu cihazı mevcut hesaba yedeklemek için Şimdi Eşitle’yi kullanın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Apple-Konto hat sich geändert. Verwenden Sie „Jetzt synchronisieren“, um dieses Gerät im aktuellen Konto zu sichern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte Apple a changé. Utilisez Sync Now pour sauvegarder cet appareil sur le compte actuel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta de Apple cambió. Utilice Sincronizar ahora para hacer una copia de seguridad de este dispositivo en la cuenta actual."
          }
        }
      }
    },
    "form_lab.mirror_newer_cloud": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A newer iCloud backup is available. Restore it, or use Sync Now to save this device’s data."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha yeni bir iCloud yedeği var. Geri yükleyin veya bu cihazın verilerini kaydetmek için Şimdi Eşitle’yi kullanın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neueres iCloud-Backup ist verfügbar. Stellen Sie es wieder her oder verwenden Sie „Jetzt synchronisieren“, um die Daten dieses Geräts zu speichern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sauvegarde iCloud plus récente est disponible. Restaurez-le ou utilisez Sync Now pour enregistrer les données de cet appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay disponible una copia de seguridad de iCloud más nueva. Restáuralo o usa Sync Now para guardar los datos de este dispositivo."
          }
        }
      }
    },
