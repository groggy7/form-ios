          }
        }
      }
    },
    "progression.action.deload": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progress Paused · Review Options"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlerleme Durdu · Seçenekleri Gözden Geçir"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortschritt angehalten · Überprüfungsoptionen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Progression en pause · Options de révision"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Progreso en pausa · Opciones de revisión"
          }
        }
      }
    },
    "progression.action.first_session": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First Session · Log a Baseline"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk Antrenman · Başlangıcı Kaydet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erste Sitzung · Protokollieren Sie eine Baseline"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Première session · Enregistrez une ligne de base"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primera sesión · Registrar una línea base"
          }
        }
      }
    },
    "progression.rationale.first_session": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No working-set baseline yet. Pick a manageable load for {reps} reps and log every working set."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz çalışma seti kaydı yok. {reps} tekrar için kontrol edebileceğin bir ağırlık seç ve tüm çalışma setlerini kaydet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Arbeitssatz-Basislinie. Wählen Sie eine überschaubare Last für {reps} Wiederholungen und protokollieren Sie alle Arbeitssatz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de référence de travail. Choisissez une charge gérable pour {reps} répétitions et enregistrez chaque série de travail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay una base de trabajo establecida. Elija una carga manejable para {reps} repeticiones y registre cada serie efectiva."
          }
        }
      }
    },
    "progression.rationale.increase_load": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All sets reached {ceiling} reps in two workouts. Try the new weights for {targetReps} reps; repeat the previous weights if reps or form suffer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki antrenmanda tüm setlerde {ceiling} tekrara ulaştın. Yeni ağırlıklarla {targetReps} tekrarı dene; tekrarlar veya form bozulursa önceki ağırlıkları tekrarla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Sätze erreichten {ceiling} Wiederholungen in zwei Trainingseinheiten. Probieren Sie die neuen Gewichte für {targetReps} Wiederholungen aus; Wiederholen Sie die vorherigen Gewichte, wenn Wiederholungen oder die Form darunter leiden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les séries ont atteint {ceiling} répétitions en deux entraînements. Essayez les nouveaux poids pour {targetReps} répétitions ; répéter les poids précédents si répétitions ou la forme souffrent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los series alcanzaron {ceiling} repeticiones en dos entrenamientos. Pruebe los nuevos pesos para {targetReps} repeticiones; repita los pesos anteriores si repeticiones o la forma sufren."
          }
        }
      }
    },
    "progression.rationale.increase_load_mixed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All sets reached {ceiling} reps in two workouts. Try the new weights for {targetReps} reps; repeat the previous weights if reps or form suffer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki antrenmanda tüm setlerde {ceiling} tekrara ulaştın. Yeni ağırlıklarla {targetReps} tekrarı dene; tekrarlar veya form bozulursa önceki ağırlıkları tekrarla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Sätze erreichten {ceiling} Wiederholungen in zwei Trainingseinheiten. Probieren Sie die neuen Gewichte für {targetReps} Wiederholungen aus; Wiederholen Sie die vorherigen Gewichte, wenn Wiederholungen oder die Form darunter leiden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les séries ont atteint {ceiling} répétitions en deux entraînements. Essayez les nouveaux poids pour {targetReps} répétitions ; répéter les poids précédents si répétitions ou la forme souffrent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los series alcanzaron {ceiling} repeticiones en dos entrenamientos. Pruebe los nuevos pesos para {targetReps} repeticiones; repita los pesos anteriores si repeticiones o la forma sufren."
          }
        }
      }
    },
    "progression.rationale.add_reps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep each set’s logged load. Try one more rep on each set below {ceiling}, if manageable. Effort is not measured."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her setin kayıtlı ağırlığını koru. {ceiling} tekrarın altındaki her sette, uygunsa bir tekrar daha dene. Efor ölçülmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalten Sie die protokollierte Auslastung jedes Satzes bei. Versuchen Sie bei jedem Satz unterhalb von {ceiling} eine weitere Wiederholung, sofern dies machbar ist. Aufwand wird nicht gemessen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez la charge enregistrée de chaque ensemble. Essayez une répétition supplémentaire sur chaque ensemble ci-dessous {ceiling}, si cela est gérable. L’effort ne se mesure pas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga la carga registrada de cada conjunto. Pruebe una repetición más en cada serie a continuación {ceiling}, si es manejable. El esfuerzo no se mide."
          }
        }
      }
    },
    "progression.rationale.add_reps_mixed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep each set’s own logged load. Try one more rep on each set below {ceiling}, if manageable. Effort is not measured."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her setin kendi kayıtlı ağırlığını koru. {ceiling} tekrarın altındaki her sette, uygunsa bir tekrar daha dene. Efor ölçülmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalten Sie die eigene protokollierte Last jedes Satzes bei. Versuchen Sie bei jedem Satz unterhalb von {ceiling} eine weitere Wiederholung, sofern dies machbar ist. Aufwand wird nicht gemessen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez la charge enregistrée de chaque ensemble. Essayez une répétition supplémentaire sur chaque ensemble ci-dessous {ceiling}, si cela est gérable. L’effort ne se mesure pas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga la carga registrada propia de cada conjunto. Pruebe una repetición más en cada serie a continuación {ceiling}, si es manejable. El esfuerzo no se mide."
          }
        }
      }
    },
    "progression.rationale.hold_load": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your last session was below the prescribed minimum ({floor}). Try just one more rep per set at the logged loads if manageable. If the minimum remains difficult, consider a lighter load."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son antrenman alt tekrar hedefinin ({floor}) altındaydı. Uygunsa kayıtlı ağırlıklarla set başına yalnızca bir tekrar daha dene. Alt hedef zor gelmeye devam ediyorsa daha hafif bir ağırlık düşünebilirsin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre letzte Sitzung lag unter dem vorgeschriebenen Minimum ({floor}). Versuchen Sie, sofern möglich, nur eine weitere Wiederholung pro Satz mit den protokollierten Belastungen. Wenn das Minimum weiterhin schwierig ist, sollten Sie eine geringere Belastung in Betracht ziehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre dernière séance était inférieure au minimum prescrit ({floor}). Essayez juste une répétition supplémentaire par série aux charges enregistrées si cela est gérable. Si le minimum reste difficile, envisagez une charge plus légère."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su última sesión estuvo por debajo del mínimo prescrito ({floor}). Pruebe solo una repetición más por serie con las cargas registradas si es manejable. Si el mínimo sigue siendo difícil, considere una carga más ligera."
          }
        }
      }
    },
    "progression.rationale.hold_load_mixed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some sets were below the prescribed minimum ({floor}). Keep each set’s own load and try just one more rep if manageable. If the minimum remains difficult, consider a lighter load."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı setler alt tekrar hedefinin ({floor}) altındaydı. Her setin kendi ağırlığını koru ve uygunsa yalnızca bir tekrar daha dene. Alt hedef zor gelmeye devam ediyorsa daha hafif bir ağırlık düşünebilirsin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Sätze lagen unter dem vorgeschriebenen Minimum ({floor}). Behalten Sie die Belastung jedes Satzes bei und versuchen Sie es mit einer weiteren Wiederholung, wenn es machbar ist. Wenn das Minimum weiterhin schwierig ist, sollten Sie eine geringere Belastung in Betracht ziehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains séries étaient inférieurs au minimum prescrit ({floor}). Conservez la propre charge de chaque ensemble et essayez juste une répétition supplémentaire si cela est gérable. Si le minimum reste difficile, envisagez une charge plus légère."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos series estaban por debajo del mínimo prescrito ({floor}). Mantenga la carga de cada serie e intente solo una repetición más si es manejable. Si el mínimo sigue siendo difícil, considere una carga más ligera."
          }
        }
      }
    },
    "progression.rationale.plateau": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rep gain across {sessions} full sessions at the same loads. Review your plan and how training feels; a lighter week is optional. Logs alone do not establish a need to deload."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı ağırlıklarla {sessions} tam antrenmanda tekrar artışı yok. Planını ve antrenmanda nasıl hissettiğini gözden geçir; daha hafif bir hafta isteğe bağlıdır. Kayıtlar tek başına deload gerektiğini göstermez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Wiederholung-Gewinn über vollständige {sessions}-Sitzungen hinweg bei gleichen Lasten. Überprüfen Sie Ihren Plan und wie sich das Training anfühlt. Eine leichtere Woche ist optional. Protokolle allein begründen keine Notwendigkeit zum Entladen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun gain répétition sur les sessions complètes {sessions} aux mêmes charges. Passez en revue votre plan et ce que vous ressentez lors de l'entraînement ; une semaine plus légère est facultative. Les journaux à eux seuls n’établissent pas la nécessité d’un déchargement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ganancia de repetición en sesiones completas de {sessions} con las mismas cargas. Revise su plan y cómo se siente el entrenamiento; una semana más ligera es opcional. Los registros por sí solos no establecen la necesidad de descargar."
          }
        }
      }
    },
    "progression.rationale.unverified_jump": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The latest session had an unusually large load increase. Repeat and confirm this performance before progressing further."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son antrenmanda olağandışı büyük bir ağırlık artışı kaydedildi. Daha fazla ilerlemeden önce bu performansı tekrar edip doğrula."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzte Sitzung hatte einen ungewöhnlich großen Lastanstieg. Wiederholen und bestätigen Sie diesen Vorgang, bevor Sie fortfahren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière session a connu une augmentation de charge inhabituellement importante. Répétez et confirmez cette performance avant de progresser davantage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La última sesión tuvo un aumento de carga inusualmente grande. Repita y confirme esta actuación antes de continuar."
          }
        }
      }
    },
    "progression.deload.none_headline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lighter-Week Prompt"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafif Hafta Hatırlatması Yok"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Aufforderung zur leichteren Woche"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d'invite de semaine plus légère"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin aviso de semana más ligera"
          }
        }
      }
    },
    "progression.deload.none_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logged sets alone cannot tell whether you need a deload."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı setler tek başına deload gerekip gerekmediğini göstermez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das protokollierte Sätze allein kann nicht sagen, ob Sie einen Deload benötigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le séries enregistré ne peut à lui seul dire si vous avez besoin d'un déchargement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El series registrado por sí solo no puede determinar si necesita una descarga."
          }
        }
      }
    },
    "progression.deload.stagnant_headline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review Recent Training"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son Antrenmanları Gözden Geçir"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie die letzte Training"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examiner la entraînement récente"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisar la capacitación reciente"
          }
        }
      }
    },
    "progression.deload.stagnant_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Several exercises show no load or rep gain across three logged sessions. Consider a lighter week if training feels hard to sustain; this is not a fatigue assessment."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden fazla harekette üç kayıtlı antrenmandır ağırlık veya tekrar artışı yok. Antrenmanı sürdürmek zor geliyorsa daha hafif bir hafta düşünebilirsiniz; bu bir yorgunluk değerlendirmesi değildir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrere Übungen zeigen keine Belastung oder einen Wiederholung-Zuwachs über drei protokollierte Sitzungen hinweg. Ziehen Sie eine kürzere Woche in Betracht, wenn Sie das Gefühl haben, dass das Training schwer durchzuhalten ist. Dies ist keine Ermüdungsbeurteilung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs exercices ne montrent aucune charge ou gain répétition sur trois sessions enregistrées. Envisagez une semaine plus légère si l’entraînement semble difficile à maintenir ; il ne s’agit pas d’une évaluation de la fatigue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Varios ejercicios no muestran carga o ganancia repetición en tres sesiones registradas. Considere una semana más ligera si le resulta difícil mantener el entrenamiento; Esta no es una evaluación de fatiga."
          }
        }
      }
    },
    "progression.deload.weeks_headline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Six Consecutive Training Weeks Logged"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Art Arda Altı Antrenman Haftası Kaydedildi"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sechs aufeinanderfolgende Trainingswochen protokolliert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Six semaines de entraînement consécutives enregistrées"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seis semanas de entrenamiento consecutivas registradas"
          }
        }
      }
    },
    "progression.deload.weeks_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You logged training in six consecutive weeks. A lighter week is optional, depending on your goals and experience; this does not establish overload or injury risk."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Art arda altı hafta antrenman kaydettiniz. Hedeflerinize ve deneyiminize göre daha hafif bir hafta seçebilirsiniz; bu aşırı yüklenme veya sakatlık riski kanıtı değildir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben das Training in sechs aufeinanderfolgenden Wochen protokolliert. Abhängig von Ihren Zielen und Ihrer Erfahrung ist eine leichtere Woche optional. Dies begründet weder eine Überlastung noch ein Verletzungsrisiko."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez suivi une entraînement pendant six semaines consécutives. Une semaine plus légère est facultative, en fonction de vos objectifs et de votre expérience ; cela n’établit pas de risque de surcharge ou de blessure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registraste entrenamiento en seis semanas consecutivas. Una semana más ligera es opcional, dependiendo de tus objetivos y experiencia; esto no establece riesgo de sobrecarga o lesiones."
          }
        }
      }
    },
    "progression.info.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-Progression & Deloads"
          }
        },
        "tr": {
