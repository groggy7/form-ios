    "pro.exercise_swaps.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Machine Taken? Swaps"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Makine Dolu mu? Değiştir"
          }
