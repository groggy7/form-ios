    "form_lab.no_weighted_sets": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No eligible 1–10 rep working sets in this selection. Higher-rep sets remain in your history."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu seçimde uygun 1–10 tekrarlı çalışma seti yok. Daha yüksek tekrarlı setler geçmişinizde korunur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine berechtigten 1–10 Wiederholung Arbeitssätze in dieser Auswahl. Höhere Werte-Wiederholung Sätze bleiben in Ihrem Verlauf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun 1 à 10 répétition séries de travail éligible dans cette sélection. Les séries supérieurs-répétition restent dans votre historique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay 1–10 repetición series efectivas elegibles en esta selección. Los superiores-repetición series permanecen en su historial."
          }
        }
      }
    },
    "form_lab.estimate_policy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated from your heavy working sets (1–10 reps). Sets done with reps in reserve may show a slightly lower estimate than your true maximum."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağır çalışma setlerinize (1–10 tekrar) göre tahmin edilir. Tükenişe gitmeden bıraktığınız setler, gerçek maksimum gücünüzün biraz altında görünebilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschätzt aus Ihrem schweren Arbeitssätze (1–10 Wiederholungen). Sätze, durchgeführt mit Wiederholungen in Reserve, kann einen etwas niedrigeren Schätzwert als Ihr wahres Maximum anzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimé à partir de votre séries de travail lourd (1–10 répétitions). séries effectué avec répétitions en réserve peut afficher une estimation légèrement inférieure à votre véritable maximum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimado a partir de su pesado series efectivas (1–10 repeticiones). series realizado con repeticiones en reserva puede mostrar una estimación ligeramente inferior a su máximo real."
          }
        }
      }
    },
