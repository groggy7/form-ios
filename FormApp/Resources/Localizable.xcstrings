    "progression.rationale.insufficient_data": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The latest log does not provide a complete baseline for this plan. Log all {sets} working sets with weights and reps."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son kayıt bu plan için tam bir başlangıç verisi sağlamıyor. {sets} çalışma setinin tümünde ağırlık ve tekrarları kaydet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das neueste Protokoll bietet keine vollständige Basis für diesen Plan. Protokollieren Sie alle {sets} Arbeitssätze mit Gewichten und Wiederholungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dernier journal ne fournit pas une référence complète pour ce plan. Enregistrez tous les {sets} séries de travail avec les poids et les répétitions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro más reciente no proporciona una base de referencia completa para este plan. Registre todos los {sets} series efectivas con pesos y repeticiones."
          }
        }
      }
    },
    "progression.rationale.repeat_ceiling": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeat these weights for {ceiling} reps per set. Confirm the same result in another workout before adding weight."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ağırlıklarla her sette {ceiling} tekrarı tekrarla. Ağırlık artırmadan önce aynı sonucu bir antrenmanda daha doğrula."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederholen Sie diese Gewichte für {ceiling} Wiederholungen pro Satz. Bestätigen Sie das gleiche Ergebnis bei einem weiteren Training, bevor Sie Gewicht hinzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répétez ces poids pour {ceiling} répétitions par jeu. Confirmez le même résultat lors d’un autre entraînement avant d’ajouter du poids."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repita estos pesos para {ceiling} repeticiones por juego. Confirma el mismo resultado en otro entrenamiento antes de agregar peso."
          }
        }
      }
    },
    "progression.rationale.load_step_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You reached the top of the rep range. Repeat the logged loads, or choose a small available increase yourself if manageable. No automatic load increase is offered for this baseline."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üst tekrar hedefine ulaştın. Kayıtlı ağırlıkları tekrarla veya uygunsa ekipmanında bulunan küçük bir artışı kendin seç. Bu başlangıç verisi için otomatik ağırlık artışı sunulmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben die Spitze der Wiederholung-Reihe erreicht. Wiederholen Sie die protokollierten Lasten oder wählen Sie selbst eine kleine verfügbare Erhöhung aus, wenn dies machbar ist. Für diese Baseline wird keine automatische Lasterhöhung angeboten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez atteint le sommet de la gamme répétition. Répétez les charges enregistrées ou choisissez vous-même une petite augmentation disponible si cela est gérable. Aucune augmentation automatique de charge n’est proposée pour cette référence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has llegado a lo más alto de la gama repetición. Repita las cargas registradas o elija usted mismo un pequeño aumento disponible si es manejable. No se ofrece ningún aumento de carga automático para esta línea base."
          }
        }
      }
    },
    "progression.info.rules": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progression rules"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlerleme kuralları"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortschrittsregeln"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règles de progression"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reglas de progresión"
          }
        }
      }
    },
    "progression.info.rule_load_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase weight · Keep reps"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağırlığı artır · Tekrarı koru"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewicht erhöhen · Wiederholungen beibehalten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmenter le poids · Gardez répétitions"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumentar peso · Mantener repeticiones"
          }
        }
      }
    },
    "progression.info.rule_load": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reach the rep ceiling in every set twice at the same weights. Then try a small available increase while aiming to keep the same reps, if manageable. Use a smaller increase or repeat the load if reps or form suffer. No automatic increases for bodyweight or unsupported equipment."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı ağırlıklarla iki tam antrenmanda her sette üst tekrar sınırına ulaş. Sonra uygunsa aynı tekrarları hedefleyerek ekipmanında bulunan küçük bir artışı dene. Tekrarlar veya form bozulursa daha küçük bir artış kullan ya da ağırlığı tekrarla. Vücut ağırlığı veya desteklenmeyen ekipmanda otomatik artış yoktur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreichen Sie die Wiederholungsobergrenze in jedem Satz zweimal mit den gleichen Gewichten. Versuchen Sie es dann mit einer kleinen verfügbaren Erhöhung und versuchen Sie dabei, den gleichen Wiederholungen beizubehalten, sofern dies machbar ist. Verwenden Sie eine geringere Steigerung oder wiederholen Sie die Belastung, wenn Wiederholungen oder die Form darunter leiden. Keine automatische Erhöhung des Körpergewichts oder der nicht unterstützten Ausrüstung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atteignez le plafond de répétition dans chaque série deux fois avec les mêmes poids. Essayez ensuite une petite augmentation disponible tout en visant à conserver le même répétitions, si cela est gérable. Utilisez une augmentation plus petite ou répétez la charge si répétitions ou la forme souffrent. Aucune augmentation automatique du poids corporel ou de l’équipement non pris en charge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcanza el límite de repeticiones en cada serie dos veces con el mismo peso. Luego intente con un pequeño aumento disponible mientras intenta mantener el mismo repeticiones, si es manejable. Utilice un aumento menor o repita la carga si repeticiones o la forma sufren. No hay aumentos automáticos de peso corporal o equipo sin soporte."
          }
        }
      }
    },
    "progression.info.rule_reps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep each set’s weight. Try one more rep, up to the rep ceiling, if manageable."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her setin ağırlığını koru. Uygunsa üst tekrar sınırına kadar bir tekrar daha dene."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalten Sie das Gewicht jedes Satzes bei. Versuchen Sie es mit einer weiteren Wiederholung bis zur Wiederholungsobergrenze, wenn dies machbar ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez le poids de chaque ensemble. Essayez une répétition supplémentaire, jusqu'au plafond de répétition, si cela est gérable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga el peso de cada conjunto. Pruebe una repetición más, hasta el límite de repeticiones, si es manejable."
          }
        }
      }
    },
    "progression.info.rule_hold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Below the rep minimum, add one rep at a time or go lighter. At the ceiling, repeat before adding weight."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt tekrar sınırının altında birer tekrar ekle veya ağırlığı azalt. Üst sınırda ağırlık artırmadan önce performansını tekrarla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterhalb des Wiederholung-Minimums fügen Sie jeweils einen Wiederholung hinzu oder reduzieren Sie die Menge. Wiederholen Sie den Vorgang an der Decke, bevor Sie Gewicht hinzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En dessous du minimum répétition, ajoutez un répétition à la fois ou allez plus léger. Au plafond, répétez avant d’ajouter du poids."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por debajo del mínimo de repetición, agregue un repetición a la vez o vaya más ligero. En el techo, repita antes de agregar peso."
          }
        }
      }
    },
    "progression.info.rule_review": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review your plan when progress stalls. A lighter week is optional; no deload target is applied."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlerleme durduğunda planını gözden geçir. Daha hafif bir hafta isteğe bağlıdır; deload hedefi uygulanmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie Ihren Plan, wenn der Fortschritt ins Stocken gerät. Eine leichtere Woche ist optional; Es wird kein Deload-Ziel angewendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoyez votre plan lorsque les progrès s’arrêtent. Une semaine plus légère est facultative ; aucune cible de chargement n’est appliquée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise su plan cuando el progreso se detenga. Una semana más ligera es opcional; no se aplica ningún objetivo de descarga."
          }
        }
      }
    },
    "progression.action.increase_load": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a small weight increase"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçük bir ağırlık artışı dene"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuchen Sie es mit einer kleinen Gewichtszunahme"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez une petite augmentation de poids"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pruebe con un pequeño aumento de peso"
          }
        }
      }
    },
    "progression.action.add_reps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build Reps · Stay at Weight"
          }
        },
        "tr": {
          "stringUnit": {
