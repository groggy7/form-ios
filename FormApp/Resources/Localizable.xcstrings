        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie Gewicht und Wiederholungen für jedes Arbeitssatz ein, markieren Sie jedes einzelne ✓, beenden Sie dann Ihr Training und speichern Sie es."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
