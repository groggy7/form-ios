    "form_lab.balance.push_dominant_alert": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're logging more push sets than pull sets."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çekişe kıyasla daha fazla itiş seti yapıyorsunuz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie protokollieren mehr Push-Sätze als Pull-Sätze."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous enregistrez plus de push séries que de pull séries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás registrando más push series que pull series."
          }
        }
      }
    },
    "form_lab.balance.pull_dominant_alert": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're logging more pull sets than push sets."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İtişe kıyasla daha fazla çekiş seti yapıyorsunuz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie protokollieren mehr Pull-Sätze als Push-Sätze."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous enregistrez plus de pull séries que de push séries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás registrando más extracción de series que inserción de series."
          }
        }
      }
    },
    "form_lab.balance.push_pull_optimal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push and pull sets are well-balanced. Great for well-rounded shoulder and upper back work."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İtiş ve çekiş setleri gayet dengeli. Omuz ve sırt gelişimi için ideal bir uyum."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Push und Pull Sätze sind gut ausbalanciert. Ideal für eine abgerundete Schulter- und obere Rückenarbeit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pousser et tirer les séries sont bien équilibrés. Idéal pour un travail bien arrondi des épaules et du haut du dos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empujar y tirar series están bien equilibrados. Ideal para trabajos de hombros y espalda superior bien redondeados."
          }
        }
      }
    },
    "form_lab.balance.push_dominant_rec": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consider adding a few more rowing or pull-up sets to keep your upper body balanced."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üst vücut dengesini korumak için programınıza birkaç set kürek (row) veya barfiks eklemeyi düşünebilirsiniz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erwägen Sie, noch ein paar Ruder- oder Klimmzugübungen durchzuführen, um Ihren Oberkörper im Gleichgewicht zu halten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensez à ajouter quelques séries supplémentaires d’aviron ou de traction pour garder le haut de votre corps en équilibre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Considere agregar un poco más de remo o dominadas series para mantener la parte superior del cuerpo equilibrada."
          }
        }
      }
    },
    "form_lab.balance.pull_dominant_rec": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensure your bench or overhead pressing gets enough attention if overall balance is your goal."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengeli bir gelişim hedefliyorsanız bench press ve omuz presi gibi itiş hareketlerinizi ihmal etmeyin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie sicher, dass Ihr Bank- oder Überkopfdrücken genügend Aufmerksamkeit erhält, wenn das Gesamtgleichgewicht Ihr Ziel ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assurez-vous que votre banc ou votre pressing aérien reçoive suffisamment d’attention si votre objectif est l’équilibre général."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrese de que su banco o press de banca reciba suficiente atención si su objetivo es el equilibrio general."
          }
        }
      }
    },
    "form_lab.balance.push_pull_optimal_rec": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue with your current routine—your pushing and pulling volume is in a great spot."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut programınızla devam edin; itiş ve çekiş hacminiz gayet iyi bir dengede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fahren Sie mit Ihrer aktuellen Routine fort – Ihr Druck- und Zugvolumen ist in einem tollen Zustand."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez votre routine actuelle : votre volume de poussée et de traction est au bon endroit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continúe con su rutina actual: su volumen de empujar y tirar está en un excelente lugar."
          }
        }
      }
    },
    "form_lab.balance.quad_ham_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quads vs. Hamstrings"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
