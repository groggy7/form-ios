    "form_lab.balance.classification": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Movement ratios count primary muscle targets only to keep comparisons clear and direct."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hareket dengesi oranları, karşılaştırmayı net tutmak için yalnızca birincil hedef kasları sayar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegungsverhältnisse zählen nur primäre Muskelziele, um Vergleiche klar und direkt zu ermöglichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rapports de mouvement comptent les cibles musculaires principales uniquement pour que les comparaisons soient claires et directes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las proporciones de movimiento cuentan los objetivos musculares primarios sólo para mantener las comparaciones claras y directas."
          }
        }
      }
    },
