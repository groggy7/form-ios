    "rest.backgroundExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xiaomi and HyperOS can prevent Forced Rep from delivering a finished timer until you reopen the app. Open Background autostart, enable Forced Rep, then return."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xiaomi ve HyperOS, uygulamayı yeniden açana kadar Forced Rep'in biten süre uyarısını göndermesini engelleyebilir. Arka planda otomatik başlatma ekranını aç, Forced Rep'i etkinleştir ve geri dön."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Xiaomi und HyperOS können verhindern, dass Forced Rep einen fertigen Timer liefert, bis Sie die App erneut öffnen. Öffnen Sie den Hintergrund-Autostart, aktivieren Sie Forced Rep und kehren Sie dann zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xiaomi et HyperOS peuvent empêcher Forced Rep de fournir une minuterie terminée jusqu'à ce que vous rouvriez l'application. Ouvrez le démarrage automatique en arrière-plan, activez Forced Rep, puis revenez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Xiaomi y HyperOS pueden evitar que Forced Rep entregue un temporizador finalizado hasta que vuelva a abrir la aplicación. Abra el inicio automático en segundo plano, habilite Forced Rep y luego regrese."
          }
        }
      }
    },
