    "matrix.info.overviewTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What This Matrix Shows"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Matris Ne Gösterir?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was diese Matrix zeigt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que montre cette matrice"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que muestra esta matriz"
          }
        }
      }
    },
    "matrix.info.overviewText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracks your weekly working sets across 18 muscle groups against benchmark volume targets. It provides a clear visual guide for muscle balance and workload—not a diagnosis of recovery or fatigue, which varies by sleep, nutrition, and experience."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "18 kas grubundaki haftalık çalışma setlerinizi genel kabul gören hacim hedefleriyle karşılaştırır. Hangi kasları ne kadar çalıştırdığınızı gösteren pratik bir rehberdir; toparlanma uykunuza ve beslenmenize de bağlı olduğundan tıbbi tanı niteliği taşımaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleicht deine wöchentlichen Arbeitssätze für 18 Muskelgruppen mit Volumenreferenzen. Die Übersicht zeigt die Verteilung des Trainingsvolumens. Sie stellt keine Diagnose von Erholung oder Ermüdung dar; diese hängen unter anderem von Schlaf, Ernährung und Erfahrung ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare vos séries de travail hebdomadaires pour 18 groupes musculaires à des références de volume. Cette vue montre la répartition du volume d’entraînement. Elle ne diagnostique ni la récupération ni la fatigue, qui dépendent notamment du sommeil, de l’alimentation et de l’expérience."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara tus series efectivas semanales de 18 grupos musculares con referencias de volumen. Esta vista muestra la distribución del volumen de entrenamiento. No diagnostica la recuperación ni la fatiga, que dependen, entre otros factores, del sueño, la alimentación y la experiencia."
          }
        }
      }
    },
    "matrix.info.calculationTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How Volume is Counted"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacim Nasıl Hesaplanır?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie das Volumen gezählt wird"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment le volume est compté"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo se cuenta el volumen"
          }
        }
      }
    },
    "matrix.info.directSetsTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct Sets (1.0×)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrudan Setler (1.0×)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkte Sätze (1,0×)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Séries directes (1,0×)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Series directas (1,0×)"
          }
        }
      }
    },
    "matrix.info.directSetsDesc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Primary target muscles get full credit (1.0 set). For example, your chest receives full credit on a bench press."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harekette birincil çalışan kas tam puan (1,0 set) alır. Örneğin bench press yaparken göğüs kasınız tam set sayılır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Primäre Zielmuskeln werden voll angerechnet (1,0 Satz). Beim Bankdrücken zählt zum Beispiel deine Brust voll."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les muscles cibles principaux reçoivent le crédit complet (1,0 série). Par exemple, vos pectoraux reçoivent tout le crédit lors d’un développé couché."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los músculos objetivo principales reciben el crédito completo (1,0 serie). Por ejemplo, tu pecho recibe todo el crédito en un press de banca."
          }
        }
      }
    },
    "matrix.info.indirectSetsTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Indirect Sets (0.5×)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolaylı Setler (0.5×)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Indirekte Sätze (0,5×)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Séries indirectes (0,5×)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Series indirectas (0,5×)"
          }
        }
      }
    },
    "matrix.info.indirectSetsDesc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assisting muscles get half credit (0.5 set)—like your triceps and front shoulders supporting a bench press."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harekete yardımcı olan ikincil kaslar yarım puan (0,5 set) alır; bench press sırasında göğse destek olan arka kol ve ön omuz gibi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterstützende Muskeln werden zur Hälfte angerechnet (0,5 Satz) – etwa Trizeps und vordere Schultern beim Bankdrücken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les muscles auxiliaires reçoivent la moitié du crédit (0,5 série), comme les triceps et l’avant des épaules lors d’un développé couché."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los músculos auxiliares reciben la mitad del crédito (0,5 serie), como los tríceps y los hombros delanteros en el press de banca."
          }
        }
      }
    },
