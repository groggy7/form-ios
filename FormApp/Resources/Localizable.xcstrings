    "pro.form_lab.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multi-rep max matrix, longitudinal strength curves, and training-distribution comparisons."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çoklu tekrar maksimum matrisi, boylamsal güç eğrileri ve antrenman dağılımı karşılaştırmaları."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Multi-Wiederholung-Max-Matrix, longitudinale Kraftkurven und Trainingsverteilungsvergleiche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Matrice max multi-répétition, courbes de résistance longitudinale et comparaisons de distribution d'entraînement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Matriz máxima Multi-repetición, curvas de fuerza longitudinal y comparaciones de distribución de entrenamiento."
          }
        }
      }
    },
