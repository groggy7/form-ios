    "programs.restoreHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This replaces all programs, completion records and workout history, and discards any active workout. To change one program, cancel and use Programs → Import program instead."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm programlar, tamamlanma kayıtları ve antrenman geçmişi değiştirilir, aktif antrenman iptal edilir. Tek programı değiştirmek için iptal et ve Programlar → Program içe aktar seçeneğini kullan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle Programme, Abschlussdaten und der Trainingsverlauf ersetzt, und ein laufendes Training wird verworfen. Um nur ein Programm zu ändern, brich ab und verwende stattdessen Programme → Programm importieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela remplace tous les programmes, les enregistrements d'achèvement et l'historique des entraînements, et supprime tout entraînement actif. Pour modifier un programme, annulez et utilisez Programmes → Importer un programme à la place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto reemplaza todos los programas, registros de finalización e historial de entrenamiento, y descarta cualquier entrenamiento activo. Para cambiar un solo programa, cancela y usa Programas → Importar programa."
          }
        }
      }
