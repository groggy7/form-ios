    "paywall.form_lab.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn your saved sets into rep-max estimates, strength trends and a clear view of your training."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı setlerinden tahmini tekrar maksimumlarını, kuvvet eğilimlerini ve antrenman dağılımını gör."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte aus deinen gespeicherten Sätzen geschätzte Maximalgewichte, Kraftverläufe und einen klaren Überblick über dein Training."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformez vos séries enregistrées en estimations de charges maximales, courbes de force et vue claire de votre entraînement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte tus series registradas en estimaciones de cargas máximas, evolución de fuerza y una visión clara de tu entrenamiento."
          }
        }
      }
    },
