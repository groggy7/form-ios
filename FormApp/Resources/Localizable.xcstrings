    "pro.volume_matrix.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare direct and indirect set estimates with fixed volume reference ranges in an anatomical heatmap. Not a recovery assessment."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anatomik ısı haritasında doğrudan ve dolaylı set tahminlerini sabit hacim referans aralıklarıyla karşılaştırın. Toparlanma değerlendirmesi değildir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche direkte und indirekte Satzschätzungen mit festen Volumenreferenzbereichen in einer anatomischen Heatmap. Dies ist keine Beurteilung deiner Erholung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparez les estimations de séries directes et indirectes à des plages de volume fixes sur une carte musculaire. Il ne s’agit pas d’une évaluation de votre récupération."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara las estimaciones de series directas e indirectas con rangos fijos de volumen en un mapa muscular. No es una evaluación de tu recuperación."
          }
        }
      }
    },
