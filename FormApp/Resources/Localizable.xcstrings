    "onboarding.frequency.days4.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sweet spot. Balanced upper/lower splits with plenty of recovery."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En dengeli oran. Üst/Alt vücut bölüşümü ve bol toparlanma süresi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sweetspot. Ausgewogene Ober-/Unterkörper-Splits mit viel Erholung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le juste milieu. Programmes haut/bas du corps équilibrés avec beaucoup de récupération."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El punto ideal. Rutinas torso/pierna equilibradas con mucha recuperación."
          }
        }
