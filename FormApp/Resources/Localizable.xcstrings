    "pro.form_lab.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multi-rep max matrix, longitudinal strength curves, and training-distribution comparisons."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çoklu tekrar maksimum matrisi, boylamsal güç eğrileri ve antrenman dağılımı karşılaştırmaları."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Matrix der Wiederholungsmaxima, langfristige Kraftkurven und Vergleiche der Trainingsverteilung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Matrice des maxima par répétitions, courbes de force dans le temps et comparaisons de répartition de l’entraînement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Matriz de máximos por repeticiones, curvas de fuerza a lo largo del tiempo y comparaciones de distribución del entrenamiento."
          }
        }
      }
    },
    "pro.form_lab.teaser": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strength progression curves & multi-rep max analytics"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güç gelişim eğrileri ve maksimum tekrar analizi"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kraftverlaufskurven und Analysen der Wiederholungsmaxima"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Courbes de progression de la force et analyses des maxima par répétitions"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Curvas de progresión de fuerza y análisis de máximos por repeticiones"
          }
        }
      }
    },
    "pro.cloud_backup.title": {
