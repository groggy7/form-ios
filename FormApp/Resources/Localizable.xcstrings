    "progression.action.first_session": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First Session · Log a Baseline"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk Antrenman · Başlangıcı Kaydet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstes Training · Ausgangswert erfassen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Première séance · Enregistrer une référence"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primera sesión · Registrar una referencia"
          }
        }
      }
    },
    "progression.rationale.first_session": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No working-set baseline yet. Pick a manageable load for {reps} reps and log every working set."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz çalışma seti kaydı yok. {reps} tekrar için kontrol edebileceğin bir ağırlık seç ve tüm çalışma setlerini kaydet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Grundlage aus Arbeitssätzen vorhanden. Wähle ein gut kontrollierbares Gewicht für {reps} Wiederholungen und zeichne jeden Arbeitssatz auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune référence de séries de travail pour le moment. Choisissez une charge maîtrisable pour {reps} répétitions et enregistrez chaque série de travail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay una referencia de series efectivas. Elige una carga que puedas controlar durante {reps} repeticiones y registra cada serie efectiva."
          }
        }
      }
    },
    "progression.rationale.increase_load": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All sets reached {ceiling} reps in two workouts. Try the new weights for {targetReps} reps; repeat the previous weights if reps or form suffer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki antrenmanda tüm setlerde {ceiling} tekrara ulaştın. Yeni ağırlıklarla {targetReps} tekrarı dene; tekrarlar veya form bozulursa önceki ağırlıkları tekrarla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Sätze erreichten in zwei Trainings {ceiling} Wiederholungen. Versuche die neuen Gewichte für {targetReps} Wiederholungen; wiederhole die vorherigen Gewichte, wenn Wiederholungen oder Technik leiden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les séries ont atteint {ceiling} répétitions lors de deux entraînements. Essayez les nouvelles charges pour {targetReps} répétitions ; reprenez les charges précédentes si les répétitions ou la technique en souffrent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las series alcanzaron {ceiling} repeticiones en dos entrenamientos. Prueba los nuevos pesos para {targetReps} repeticiones; repite los pesos anteriores si las repeticiones o la técnica empeoran."
          }
        }
      }
    },
    "progression.rationale.increase_load_mixed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All sets reached {ceiling} reps in two workouts. Try the new weights for {targetReps} reps; repeat the previous weights if reps or form suffer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki antrenmanda tüm setlerde {ceiling} tekrara ulaştın. Yeni ağırlıklarla {targetReps} tekrarı dene; tekrarlar veya form bozulursa önceki ağırlıkları tekrarla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Sätze erreichten in zwei Trainings {ceiling} Wiederholungen. Versuche die neuen Gewichte für {targetReps} Wiederholungen; wiederhole die vorherigen Gewichte, wenn Wiederholungen oder Technik leiden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les séries ont atteint {ceiling} répétitions lors de deux entraînements. Essayez les nouvelles charges pour {targetReps} répétitions ; reprenez les charges précédentes si les répétitions ou la technique en souffrent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las series alcanzaron {ceiling} repeticiones en dos entrenamientos. Prueba los nuevos pesos para {targetReps} repeticiones; repite los pesos anteriores si las repeticiones o la técnica empeoran."
          }
        }
      }
    },
    "progression.rationale.add_reps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep each set’s logged load. Try one more rep on each set below {ceiling}, if manageable. Effort is not measured."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her setin kayıtlı ağırlığını koru. {ceiling} tekrarın altındaki her sette, uygunsa bir tekrar daha dene. Efor ölçülmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte das protokollierte Gewicht jedes Satzes bei. Versuche bei jedem Satz unter {ceiling} eine Wiederholung mehr, wenn machbar. Die Anstrengung wird nicht gemessen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez la charge enregistrée de chaque série. Essayez une répétition de plus sur chaque série sous {ceiling}, si c’est gérable. L’effort n’est pas mesuré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la carga registrada de cada serie. Prueba una repetición más en cada serie por debajo de {ceiling}, si es manejable. El esfuerzo no se mide."
          }
        }
      }
    },
    "progression.rationale.add_reps_mixed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep each set’s own logged load. Try one more rep on each set below {ceiling}, if manageable. Effort is not measured."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her setin kendi kayıtlı ağırlığını koru. {ceiling} tekrarın altındaki her sette, uygunsa bir tekrar daha dene. Efor ölçülmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte das jeweils eigene protokollierte Gewicht jedes Satzes bei. Versuche bei jedem Satz unter {ceiling} eine Wiederholung mehr, wenn machbar. Die Anstrengung wird nicht gemessen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez la charge enregistrée propre à chaque série. Essayez une répétition de plus sur chaque série sous {ceiling}, si c’est gérable. L’effort n’est pas mesuré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la carga registrada propia de cada serie. Prueba una repetición más en cada serie por debajo de {ceiling}, si es manejable. El esfuerzo no se mide."
          }
        }
      }
    },
    "progression.rationale.hold_load": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your last session was below the prescribed minimum ({floor}). Try just one more rep per set at the logged loads if manageable. If the minimum remains difficult, consider a lighter load."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son antrenman alt tekrar hedefinin ({floor}) altındaydı. Uygunsa kayıtlı ağırlıklarla set başına yalnızca bir tekrar daha dene. Alt hedef zor gelmeye devam ediyorsa daha hafif bir ağırlık düşünebilirsin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein letztes Training lag unter dem vorgegebenen Minimum ({floor}). Versuche mit den protokollierten Gewichten nur eine Wiederholung mehr pro Satz, wenn machbar. Bleibt das Minimum schwierig, erwäge ein leichteres Gewicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre dernière séance était inférieure au minimum prescrit ({floor}). Essayez juste une répétition supplémentaire par série aux charges enregistrées si cela est gérable. Si le minimum reste difficile, envisagez une charge plus légère."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu última sesión estuvo por debajo del mínimo prescrito ({floor}). Prueba solo una repetición más por serie con las cargas registradas si es manejable. Si el mínimo sigue costando, considera una carga más ligera."
          }
        }
      }
    },
    "progression.rationale.hold_load_mixed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some sets were below the prescribed minimum ({floor}). Keep each set’s own load and try just one more rep if manageable. If the minimum remains difficult, consider a lighter load."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı setler alt tekrar hedefinin ({floor}) altındaydı. Her setin kendi ağırlığını koru ve uygunsa yalnızca bir tekrar daha dene. Alt hedef zor gelmeye devam ediyorsa daha hafif bir ağırlık düşünebilirsin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Sätze lagen unter dem vorgegebenen Minimum ({floor}). Behalte das jeweilige Gewicht jedes Satzes bei und versuche nur eine Wiederholung mehr, wenn machbar. Bleibt das Minimum schwierig, erwäge ein leichteres Gewicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines séries étaient sous le minimum prescrit ({floor}). Conservez la charge propre à chaque série et essayez juste une répétition de plus si c’est gérable. Si le minimum reste difficile, envisagez une charge plus légère."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas series estuvieron por debajo del mínimo prescrito ({floor}). Mantén la carga de cada serie e intenta solo una repetición más si es manejable. Si el mínimo sigue costando, considera una carga más ligera."
          }
        }
      }
    },
    "progression.rationale.plateau": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rep gain across {sessions} full sessions at the same loads. Review your plan and how training feels; a lighter week is optional. Logs alone do not establish a need to deload."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı ağırlıklarla {sessions} tam antrenmanda tekrar artışı yok. Planını ve antrenmanda nasıl hissettiğini gözden geçir; daha hafif bir hafta isteğe bağlıdır. Kayıtlar tek başına deload gerektiğini göstermez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Wiederholungszuwachs über {sessions} vollständige Trainings mit gleichen Gewichten. Überprüfe deinen Plan und wie sich das Training anfühlt; eine leichtere Woche ist optional. Protokolle allein belegen keinen Bedarf für einen Deload."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun gain de répétitions sur {sessions} séances complètes aux mêmes charges. Revoyez votre plan et vos sensations à l’entraînement ; une semaine plus légère est facultative. Les enregistrements seuls ne justifient pas une décharge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin aumento de repeticiones en {sessions} sesiones completas con las mismas cargas. Revisa tu plan y cómo te sientes al entrenar; una semana más ligera es opcional. Los registros por sí solos no demuestran que necesites una descarga."
          }
        }
      }
    },
    "progression.rationale.unverified_jump": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The latest session had an unusually large load increase. Repeat and confirm this performance before progressing further."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son antrenmanda olağandışı büyük bir ağırlık artışı kaydedildi. Daha fazla ilerlemeden önce bu performansı tekrar edip doğrula."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das letzte Training hatte einen ungewöhnlich großen Gewichtssprung. Wiederhole und bestätige diese Leistung, bevor du weiter steigerst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière séance comportait une hausse de charge inhabituellement importante. Répétez et confirmez cette performance avant de progresser davantage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La última sesión tuvo un aumento de carga inusualmente grande. Repite y confirma este rendimiento antes de seguir progresando."
          }
        }
      }
    },
    "progression.rationale.stale_baseline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your latest full log for this workout is more than 4 weeks old. Repeat those weights and reps to re-establish your baseline before adding reps or weight."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu antrenmandaki son tam kaydın 4 haftadan eski. Tekrar veya ağırlık eklemeden önce başlangıç verini yeniden oluşturmak için aynı ağırlık ve tekrarları tekrarla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein letztes vollständiges Protokoll für dieses Training ist älter als 4 Wochen. Wiederhole diese Gewichte und Wiederholungen, um deine Ausgangsbasis neu zu bestätigen, bevor du Wiederholungen oder Gewicht hinzufügst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre dernier enregistrement complet pour cette séance date de plus de 4 semaines. Répétez ces charges et répétitions pour rétablir votre base avant d’ajouter des répétitions ou du poids."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu último registro completo de este entrenamiento tiene más de 4 semanas. Repite esos pesos y repeticiones para restablecer tu referencia antes de añadir repeticiones o peso."
          }
        }
      }
    },
    "progression.deload.none_headline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lighter-Week Prompt"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafif Hafta Hatırlatması Yok"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Hinweis auf eine leichtere Woche"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune suggestion de semaine plus légère"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin aviso de semana más ligera"
          }
        }
      }
    },
    "progression.deload.none_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logged sets alone cannot tell whether you need a deload."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı setler tek başına deload gerekip gerekmediğini göstermez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Protokollierte Sätze allein zeigen nicht, ob du einen Deload brauchst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les séries enregistrées ne suffisent pas à dire si vous avez besoin d’une décharge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las series registradas por sí solas no pueden indicar si necesitas una descarga."
          }
        }
      }
    },
    "progression.deload.stagnant_headline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review Recent Training"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son Antrenmanları Gözden Geçir"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzte Trainings prüfen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examiner l’entraînement récent"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisar el entrenamiento reciente"
          }
        }
      }
    },
    "progression.deload.stagnant_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Several exercises show no load or rep gain across three logged sessions. Consider a lighter week if training feels hard to sustain; this is not a fatigue assessment."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden fazla harekette üç kayıtlı antrenmandır ağırlık veya tekrar artışı yok. Antrenmanı sürdürmek zor geliyorsa daha hafif bir hafta düşünebilirsiniz; bu bir yorgunluk değerlendirmesi değildir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrere Übungen zeigen über drei protokollierte Trainings keinen Gewichts- oder Wiederholungszuwachs. Erwäge eine leichtere Woche, wenn sich das Training schwer durchhalten lässt; dies ist keine Ermüdungsbeurteilung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs exercices ne montrent aucun gain de charge ou de répétitions sur trois séances enregistrées. Envisagez une semaine plus légère si l’entraînement semble difficile à maintenir ; il ne s’agit pas d’une évaluation de la fatigue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Varios ejercicios no muestran aumento de carga ni de repeticiones en tres sesiones registradas. Considera una semana más ligera si te cuesta mantener el entrenamiento; esto no es una evaluación de la fatiga."
          }
        }
      }
    },
    "progression.deload.weeks_headline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Six Consecutive Training Weeks Logged"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Art Arda Altı Antrenman Haftası Kaydedildi"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sechs aufeinanderfolgende Trainingswochen protokolliert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Six semaines d’entraînement consécutives enregistrées"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seis semanas de entrenamiento consecutivas registradas"
          }
        }
      }
    },
    "progression.deload.weeks_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You logged training in six consecutive weeks. A lighter week is optional, depending on your goals and experience; this does not establish overload or injury risk."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Art arda altı hafta antrenman kaydettiniz. Hedeflerinize ve deneyiminize göre daha hafif bir hafta seçebilirsiniz; bu aşırı yüklenme veya sakatlık riski kanıtı değildir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast in sechs aufeinanderfolgenden Wochen Training protokolliert. Eine leichtere Woche ist optional, je nach Zielen und Erfahrung; dies belegt weder Überlastung noch Verletzungsrisiko."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez enregistré des entraînements pendant six semaines consécutives. Une semaine plus légère est facultative, selon vos objectifs et votre expérience ; cela n’indique ni surcharge ni risque de blessure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registraste entrenamiento en seis semanas consecutivas. Una semana más ligera es opcional, dependiendo de tus objetivos y experiencia; esto no establece riesgo de sobrecarga o lesiones."
          }
        }
      }
    },
    "progression.info.title": {
      "extractionState": "manual",
      "localizations": {
