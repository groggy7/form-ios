    "paywall.cloud_backup.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back up your programs and workout history locally, with iCloud Drive when available."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Programlarını ve antrenman geçmişini cihazına, kullanılabiliyorsa iCloud Drive'a yedekle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere Programme und Trainingshistorie lokal und, wenn verfügbar, in iCloud Drive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez vos programmes et votre historique localement et dans iCloud Drive lorsque ce service est disponible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tus programas e historial localmente y en iCloud Drive cuando esté disponible."
          }
        }
      }
    },
