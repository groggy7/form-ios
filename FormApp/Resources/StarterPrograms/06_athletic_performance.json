{
  "format": "form.program",
  "schemaVersion": 3,
  "program": {
    "id": "athletic-performance",
    "name": "Athletic Engine: 3-Day Performance",
    "description": "A 3-day athletic performance program designed to build explosive lower body power, rotational core stability, vertical jump, and work capacity.",
    "guidelines": [
      "Perform all power exercises (jumps, push press, swings) first while neurologically fresh.",
      "Move every rep with explosive intent.",
      "Rest 2\u20133 minutes on power and compound lifts."
