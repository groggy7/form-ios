    "rest.backgroundExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xiaomi and HyperOS can prevent Forced Rep from delivering a finished timer until you reopen the app. Open Background autostart, enable Forced Rep, then return."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xiaomi ve HyperOS, uygulamayı yeniden açana kadar Forced Rep'in biten süre uyarısını göndermesini engelleyebilir. Arka planda otomatik başlatma ekranını aç, Forced Rep'i etkinleştir ve geri dön."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Xiaomi und HyperOS können verhindern, dass Forced Rep das Ende eines Timers meldet, bis du die App erneut öffnest. Öffne den Hintergrund-Autostart, aktiviere Forced Rep und kehre dann zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xiaomi et HyperOS peuvent empêcher Forced Rep de signaler la fin d’un minuteur jusqu’à ce que vous rouvriez l’application. Ouvrez le démarrage automatique en arrière-plan, activez Forced Rep, puis revenez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Xiaomi y HyperOS pueden impedir que Forced Rep avise del final de un temporizador hasta que vuelvas a abrir la app. Abre el inicio automático en segundo plano, activa Forced Rep y vuelve."
          }
        }
      }
    },
