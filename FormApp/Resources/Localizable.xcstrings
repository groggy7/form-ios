    "pro.exercise_swaps.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap a busy machine for a matched substitute mid-workout without changing your program."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolu bir makineyi antrenman sırasında programını değiştirmeden uygun bir alternatifle değiştir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tausche ein belegtes Gerät mitten im Training gegen eine passende Alternative, ohne deinen Plan zu ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacez une machine occupée par une alternative adaptée en pleine séance, sans modifier votre programme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia una máquina ocupada por una alternativa adecuada en mitad del entrenamiento sin modificar tu plan."
          }
        }
      }
    },
