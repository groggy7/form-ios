    "progression.coach.first_session_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter weight and reps for every working set, mark each one ✓, then finish and save your workout."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her çalışma setinde ağırlık ve tekrarlarını gir, ✓ ile kaydet, ardından antrenmanı tamamla ve kaydet."
