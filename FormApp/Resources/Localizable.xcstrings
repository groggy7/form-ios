      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This program changed since editing began. Reopen it to review the latest version; your draft is retained."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenleme başladığından beri program değişti. Güncel sürümü incelemek için yeniden açın; taslağınız saklandı."
