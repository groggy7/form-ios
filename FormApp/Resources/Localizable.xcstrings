    "table.assistance_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter assistance weight. Less assistance means more resistance; 0 means no assistance."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Destek ağırlığını gir. Daha az destek, daha fazla direnç demektir; 0, desteksizdir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib das Unterstützungsgewicht ein. Weniger Unterstützung bedeutet mehr Widerstand; 0 bedeutet keine Unterstützung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez le poids d'assistance. Moins d’assistance signifie plus de résistance ; 0 signifie aucune aide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el peso de asistencia. Menos asistencia significa más resistencia; 0 significa sin asistencia."
          }
        }
      }
    },
    "progression.coach.assistance_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep assistance, build reps"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteği koru, tekrar geliştir"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterstützung halten, Wiederholungen steigern"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez l’assistance, ajoutez des répétitions"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la asistencia, suma repeticiones"
          }
        }
      }
    },
    "progression.rationale.assistance_reps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the same assistance and build reps if manageable. Less assistance makes the exercise harder."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapabiliyorsan aynı destekle tekrarları geliştir. Daha az destek, hareketi zorlaştırır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte die gleiche Unterstützung bei und steigere die Wiederholungen, wenn machbar. Weniger Unterstützung macht die Übung schwerer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez la même assistance et ajoutez des répétitions si c’est gérable. Moins d’assistance rend l’exercice plus difficile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la misma asistencia y suma repeticiones si es manejable. Menos asistencia hace el ejercicio más difícil."
          }
        }
      }
    },
    "progression.rationale.assistance_ceiling": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeat these reps with the same assistance. If manageable, choose less assistance yourself; the app does not choose a reduction."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı destekle bu tekrarları yinele. Yapabiliyorsan desteği kendin azalt; uygulama bir azaltma seçmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederhole diese Wiederholungen mit der gleichen Unterstützung. Wenn machbar, wähle selbst weniger Unterstützung; die App wählt keine Reduzierung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répétez ces répétitions avec la même assistance. Si cela est gérable, choisissez vous-même moins d’assistance ; l'application ne choisit pas de réduction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repite estas repeticiones con la misma asistencia. Si es posible, elige tú mismo menos asistencia; la app no elige una reducción."
          }
        }
      }
    },
