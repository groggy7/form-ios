    "form_lab.rep_max_matrix_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimates from 1–10 rep working sets, not tested maximums. Rep targets are estimates, not prescribed loads."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1–10 tekrarlı çalışma setlerinden tahminlerdir; ölçülmüş maksimumlar değildir. Tekrar hedefleri önerilen yükler değil, tahminlerdir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schätzungen von 1–10 Wiederholung Arbeitssätze, nicht getestete Höchstwerte. Wiederholung-Ziele sind Schätzungen, keine vorgeschriebenen Lasten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimations de 1 à 10 répétition séries de travail, maximums non testés. Les cibles répétition sont des estimations et non des charges prescrites."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimaciones del 1 al 10 repetición series efectivas, máximos no probados. Los objetivos de repetición son estimaciones, no cargas prescritas."
          }
        }
      }
    },
