    "onboarding.frequency.days2.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimal and sustainable. Two full-body sessions for busy weeks."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ama sürdürülebilir. Yoğun haftalar için iki tüm vücut seansı."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimal und gut durchzuhalten. Zwei Ganzkörpereinheiten für volle Wochen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimal et tenable. Deux séances corps entier pour les semaines chargées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mínimo y sostenible. Dos sesiones de cuerpo completo para semanas ajetreadas."
          }
        }
      }
    },
