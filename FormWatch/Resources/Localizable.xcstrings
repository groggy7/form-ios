{
  "sourceLanguage": "en",
  "strings": {
    "watch.waiting.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No workout"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenman yok"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Training"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun entraînement"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin entrenamiento"
          }
        }
      }
    },
    "watch.waiting.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a workout on your iPhone to log its sets here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Setlerini buradan kaydetmek için iPhone'unda bir antrenman başlat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte auf deinem iPhone ein Training, um seine Sätze hier einzutragen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez un entraînement sur votre iPhone pour enregistrer ses séries ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza un entrenamiento en tu iPhone para registrar sus series aquí."
          }
        }
      }
    },
    "watch.locked.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium"
          }
        },
        "tr": {
