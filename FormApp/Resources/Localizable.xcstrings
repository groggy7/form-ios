    "pro.cloud_backup.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Post-workout backups save locally and to iCloud Drive when available. iCloud controls off-device upload."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenman sonrası yedekler yerel olarak ve kullanılabiliyorsa iCloud Drive'a kaydedilir. Cihaz dışı yüklemeyi iCloud yönetir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups nach dem Training werden lokal und auf iCloud Drive gespeichert, sofern verfügbar. iCloud steuert den Upload außerhalb des Geräts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes post-entraînement sont enregistrées localement et sur iCloud Drive lorsqu'elles sont disponibles. iCloud contrôle le téléchargement hors appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias de seguridad posteriores al entrenamiento se guardan localmente y en iCloud Drive cuando estén disponibles. iCloud controla la carga fuera del dispositivo."
          }
        }
      }
    },
    "pro.cloud_backup.teaser": {
