    "form_lab.mirror_restore_warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will restore your programs and history from the latest available local or iCloud backup. Live active workout will be preserved."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem programlarınızı ve geçmişinizi mevcut en yeni yerel veya iCloud yedeğinden geri yükler. Aktif canlı antrenmanınız korunur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden Ihre Programme und Ihr Verlauf aus dem neuesten verfügbaren lokalen oder iCloud-Backup wiederhergestellt. Das aktive Live-Training bleibt erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela restaurera vos programmes et votre historique à partir de la dernière sauvegarde locale ou iCloud disponible. L'entraînement actif en direct sera conservé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto restaurará sus programas e historial desde la última copia de seguridad local o de iCloud disponible. Se conservará el entrenamiento activo en vivo."
          }
        }
      }
    },
