    "onboarding.goal.cut.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserve lean muscle and stay conditioned while losing body fat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücut yağını azaltırken mevcut kas kütlenizi ve kondisyonunuzu koruyun."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte deine Muskelmasse und bleib in Form, während du Körperfett verlierst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préservez votre masse musculaire et restez en forme tout en perdant de la graisse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserva la masa muscular magra y mantente en forma mientras pierdes grasa corporal."
          }
        }
      }
    },
