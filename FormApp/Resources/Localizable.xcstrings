          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À partir de la charge et des répétitions (1–10)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Según la carga y las repeticiones (1–10)"
          }
        }
      }
    },
