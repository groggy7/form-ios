    "form_lab.balance_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compares your logged sets across opposing movement patterns to keep your routine well-rounded, not as a clinical diagnosis of joint health."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenmanınızın dengeli ilerlemesini sağlamak için karşıt hareket setlerinizi karşılaştırır; eklem sağlığı veya tıbbi tanı niteliği taşımaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleicht Ihre aufgezeichneten Sätze mit gegensätzlichen Bewegungsmustern, um Ihre Routine abgerundet zu halten, und nicht als klinische Diagnose der Gelenkgesundheit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare votre séries enregistré à travers des schémas de mouvements opposés pour garder votre routine bien équilibrée, et non comme un diagnostic clinique de la santé des articulations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara su series registrado en patrones de movimiento opuestos para mantener su rutina completa, no como un diagnóstico clínico de la salud de las articulaciones."
          }
        }
      }
    },
    "form_lab.balance.optimal": {
