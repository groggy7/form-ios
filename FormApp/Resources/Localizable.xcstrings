    "paywall.restore_offline_unverified": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play could not verify purchases now. Cached Premium access remains temporary; try restoring again online."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play satın alımları şu anda doğrulayamadı. Önbellekteki Premium erişimi geçicidir; çevrimiçiyken tekrar deneyin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play konnte die Käufe derzeit nicht prüfen. Der gespeicherte Premium-Zugriff bleibt vorläufig. Versuche die Wiederherstellung erneut mit Internetverbindung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play n’a pas pu vérifier les achats. L’accès Premium enregistré reste temporaire. Réessayez la restauration avec une connexion Internet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play no pudo verificar las compras. El acceso Premium guardado sigue siendo temporal. Intenta restaurarlas de nuevo con conexión."
          }
        }
      }
    },
