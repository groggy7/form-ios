        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftalık setlerinize rehberlik eden genel referans hedefleridir; kişisel toparlanma sınırı veya tıbbi tanı niteliği taşımaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
