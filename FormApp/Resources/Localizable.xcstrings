          }
        }
      }
    },
    "progression.info.ddpTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How Dynamic Double Progression Works"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinamik Çift Aşamalı İlerleme Nasıl Çalışır?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So funktioniert die dynamische Doppelprogression"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment fonctionne la double progression dynamique"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo funciona la doble progresión dinámica"
          }
        }
      }
    },
    "progression.info.ddpText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Targets use your latest full session from this workout day, or from another day with the same sets and rep range. Incomplete logs give no target. Warmups don’t count."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedefler, bu antrenman gününün ya da aynı set sayısı ve tekrar aralığına sahip başka bir günün son tam kaydına dayanır. Eksik kayıtta hedef verilmez. Isınma setleri sayılmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziele verwenden deine letzte vollständige Einheit dieses Trainingstags oder eines anderen Tages mit gleicher Satzzahl und gleichem Wiederholungsbereich. Unvollständige Protokolle ergeben kein Ziel. Aufwärmsätze zählen nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cibles utilisent votre dernière séance complète de ce jour d’entraînement, ou d’un autre jour avec le même nombre de séries et la même plage de répétitions. Les enregistrements incomplets ne donnent aucune cible. Les échauffements ne comptent pas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los objetivos usan tu última sesión completa de este día de entrenamiento, o de otro día con las mismas series y el mismo rango de repeticiones. Los registros incompletos no dan objetivo. Los calentamientos no cuentan."
          }
        }
      }
    },
    "progression.info.plateauTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Logged Progress Pauses"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı İlerleme Durduğunda"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der protokollierte Fortschritt pausiert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque la progression enregistrée s'interrompt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando el progreso registrado se detiene"
          }
        }
      }
    },
    "progression.info.plateauText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only full sessions with matching weights and set counts are compared. Below the rep ceiling, three without a total rep gain prompt a review. The app doesn’t measure fatigue, recovery or technique."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca ağırlıkları ve set sayıları aynı olan tam antrenmanlar karşılaştırılır. Üst tekrar sınırının altında üç antrenmanda toplam tekrar artmazsa planını gözden geçir. Uygulama yorgunluğu, toparlanmayı veya tekniği ölçmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden nur vollständige Trainings mit gleichen Gewichten und gleicher Satzzahl verglichen. Unterhalb der Wiederholungsobergrenze lösen drei Trainings ohne Wiederholungszuwachs eine Überprüfung aus. Die App misst weder Ermüdung, Erholung noch Technik."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les séances complètes avec les mêmes charges et le même nombre de séries sont comparées. Sous le plafond de répétitions, trois séances sans gain total de répétitions déclenchent une révision. L’application ne mesure pas la fatigue, la récupération ni la technique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se comparan sesiones completas con los mismos pesos y número de series. Por debajo del tope de repeticiones, tres sesiones sin aumento total de repeticiones activan una revisión. La app no mide la fatiga, la recuperación ni la técnica."
          }
        }
      }
    },
    "progression.info.tipTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach Tip"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koç İpucu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trainer-Tipp"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conseil de l'entraîneur"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo del entrenador"
          }
        }
      }
    },
    "progression.info.tipText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow your goals and how training feels. Logs don’t require a fixed deload schedule. A lighter week doesn’t guarantee progress or injury prevention."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedeflerini ve antrenmanda nasıl hissettiğini dikkate al. Kayıtlar sabit bir deload takvimi gerektirmez. Hafif bir hafta ilerlemeyi veya sakatlıkların önlenmesini garanti etmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte dich nach deinen Zielen und danach, wie sich das Training anfühlt. Protokolle erfordern keinen festen Deload-Plan. Eine leichtere Woche garantiert weder Fortschritt noch Verletzungsschutz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez vos objectifs et vos sensations à l’entraînement. Les enregistrements n’imposent pas de calendrier de décharge fixe. Une semaine plus légère ne garantit ni progrès ni prévention des blessures."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guíate por tus objetivos y por cómo te sientes al entrenar. Los registros no exigen un calendario fijo de descargas. Una semana más ligera no garantiza progreso ni prevención de lesiones."
          }
        }
      }
    },
