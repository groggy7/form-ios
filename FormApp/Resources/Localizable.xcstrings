    "onboarding.frequency.days3.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manageable and high-recovery. Great for full-body or athletic splits."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüksek toparlanma ve pratik. Tüm vücut veya atletik programlar için ideal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gut machbar mit viel Erholung. Ideal für Ganzkörper- oder Athletikpläne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facile à tenir, avec beaucoup de récupération. Idéal pour les programmes corps entier ou athlétiques."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Manejable y con mucha recuperación. Ideal para planes de cuerpo completo o atléticos."
          }
        }
      }
    },
