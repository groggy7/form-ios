    "settings.about": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About Forced Rep"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forced Rep hakkında"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über Forced Rep"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À propos de Forced Rep"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca de Forced Rep"
          }
        }
      }
    },
    "settings.aboutDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forced Rep is a focused strength training companion designed to log your workouts, guide your exercise technique with visual movement animations and cues, and track your progressive overload — quiet, distraction-free, and always ready."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forced Rep; antrenmanlarınızı kaydetmek, hareket animasyonları ve teknik ipuçlarıyla formunuzu geliştirmek ve güç gelişiminizi sürdürmek için tasarlanmış, sade ve temiz bir güç antrenmanı yardımcısıdır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Forced Rep ist ein fokussierter Krafttrainingsbegleiter, der Ihre Trainingseinheiten protokolliert, Ihre Trainingstechnik mit visuellen Bewegungsanimationen und Hinweisen leitet und Ihre fortschreitende Überlastung verfolgt – leise, ablenkungsfrei und immer bereit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forced Rep est un compagnon d'entraînement en force ciblé conçu pour enregistrer vos entraînements, guider votre technique d'exercice avec des animations et des signaux de mouvements visuels et suivre votre surcharge progressive — silencieux, sans distraction et toujours prêt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forced Rep es un compañero de entrenamiento de fuerza enfocado diseñado para registrar sus entrenamientos, guiar su técnica de ejercicio con señales y animaciones de movimiento visual y realizar un seguimiento de su sobrecarga progresiva: silencioso, sin distracciones y siempre listo."
          }
        }
      }
    },
