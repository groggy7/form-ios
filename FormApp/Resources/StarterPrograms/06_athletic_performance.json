        "title": "Lower Power",
        "focus": "Trap bar deadlift power, vertical box jumps, unilateral acceleration",
        "tone": "orange",
        "targetMuscles": [
          "hamstrings",
          "glutes",
          "quadriceps",
          "calves",
          "abs"
        ],
        "exercises": [
          {
            "id": "ap-trap-bar-deadlift",
            "name": "Trap Bar Deadlift",
            "movementType": "hinge",
            "movementAssetId": "trap-bar-deadlift",
            "sets": 4,
            "reps": {
              "min": 5,
              "max": 6,
              "toFailure": false,
              "perSide": false
            },
            "restSeconds": 180,
            "cues": [
              "Stand inside center of trap bar.",
              "Drive feet through floor with maximum velocity on the ascent."
            ],
            "avoid": [
              "Rounding lower spine."
            ]
          },
          {
            "id": "ap-bulgarian-split-squat",
            "name": "Bulgarian Split Squat",
            "movementType": "lunge",
            "movementAssetId": "rear-foot-elevated-split-squat",
            "sets": 3,
            "reps": {
              "min": 6,
              "max": 8,
              "toFailure": false,
              "perSide": true
            },
            "restSeconds": 90,
            "cues": [
              "Drive through front heel with explosive intent."
            ],
            "avoid": [
              "Collapsing forward."
            ]
          },
          {
            "id": "ap-bb-rdl",
            "name": "Barbell Romanian Deadlift",
            "movementType": "hinge",
            "movementAssetId": "barbell-romanian-deadlift",
            "sets": 3,
            "reps": {
              "min": 8,
              "max": 10,
              "toFailure": false,
              "perSide": false
            },
            "restSeconds": 120,
            "cues": [
              "Push hips back horizontally.",
              "Deep hamstring load."
            ],
            "avoid": [
              "Rounding back."
            ]
          },
          {
            "id": "ap-standing-calf",
            "name": "Standing Machine Calf Raise",
            "movementType": "calf",
            "movementAssetId": "standing-machine-calf-raise",
            "sets": 3,
            "reps": {
              "min": 12,
              "max": 15,
              "toFailure": false,
              "perSide": false
            },
            "restSeconds": 90,
            "cues": [
              "Full stretch and explosive calf drive."
            ],
            "avoid": [
              "Bouncing."
            ]
          },
          {
            "id": "ap-pallof-press",
            "name": "Pallof Press",
            "movementType": "core",
            "movementAssetId": "pallof-press",
            "sets": 3,
