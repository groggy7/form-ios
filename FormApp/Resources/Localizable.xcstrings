    "form_lab.info_mirror_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forced Rep does not operate user databases. On Android, choose a cloud-backed folder for off-device backup; your storage provider controls its sync."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forced Rep kullanıcı veritabanı tutmaz. Android'de cihaz dışı yedekleme için bulut destekli bir klasör seçin; eşitlemeyi depolama sağlayıcınız yönetir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Forced Rep betreibt keine Benutzerdatenbanken. Wähle unter Android einen cloudgesicherten Ordner für die Sicherung außerhalb des Geräts; dein Speicheranbieter steuert die Synchronisierung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forced Rep n'exploite pas de bases de données utilisateur. Sur Android, choisissez un dossier sauvegardé dans le cloud pour la sauvegarde hors appareil ; votre fournisseur de stockage contrôle sa synchronisation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forced Rep no gestiona bases de datos de usuarios. En Android, elige una carpeta respaldada en la nube para tener copias fuera del dispositivo; tu proveedor de almacenamiento controla su sincronización."
          }
        }
      }
    },
