    "onboarding.goal.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is your primary goal?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birincil hedefiniz nedir?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist Ihr primäres Ziel?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel est votre objectif principal ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuál es tu objetivo principal?"
          }
        }
      }
    },
    "onboarding.goal.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the outcome that matters most to you right now."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda sizin için en önemli olan hedefi seçin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie das Ergebnis, das Ihnen im Moment am wichtigsten ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le résultat qui compte le plus pour vous en ce moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija el resultado que más le importe en este momento."
          }
        }
      }
    },
    "onboarding.goal.bulk.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build Muscle (Bulk)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas Kütlesi Kazan (Bulk)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Muskeln aufbauen (Massentraining)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Développer du muscle (en vrac)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desarrollar músculo (a granel)"
          }
        }
      }
    },
    "onboarding.goal.bulk.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximize muscle growth, fullness, and physique development."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas büyümesini, dolgunluğunu ve fizik gelişimini maksimize edin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximieren Sie Muskelwachstum, Fülle und Körperentwicklung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximisez la croissance musculaire, la plénitude et le développement physique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximice el crecimiento muscular, la plenitud y el desarrollo físico."
          }
        }
      }
    },
    "onboarding.goal.cut.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get Lean & Tone (Cut)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yağ Yak ve Sıkılaş (Cut)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Holen Sie sich Lean & Tone (Cut)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenez maigre et tonique (coupe)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenga adelgazamiento y tono (corte)"
          }
        }
      }
    },
    "onboarding.goal.cut.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserve lean muscle and stay conditioned while losing body fat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücut yağını azaltırken mevcut kas kütlenizi ve kondisyonunuzu koruyun."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalten Sie Muskelmasse und bleiben Sie konditioniert, während Sie gleichzeitig Körperfett verlieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préservez la masse musculaire maigre et restez en forme tout en perdant de la graisse corporelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserva la masa muscular magra y mantente en forma mientras pierdes grasa corporal."
          }
        }
      }
    },
    "onboarding.goal.strength.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase Pure Strength"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saf Güç Kazan"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steigern Sie die reine Kraft"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmenter la force pure"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumentar la fuerza pura"
          }
        }
      }
    },
    "onboarding.goal.strength.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add weight to key compound lifts (squat, bench, deadlift)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temel kaldırışlarda (squat, bench, deadlift) kaldırılan ağırlıkları artırın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhöhen Sie das Gewicht bei wichtigen Verbundübungen (Kniebeugen, Bankdrücken, Kreuzheben)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez du poids aux principaux ascenseurs composés (squat, banc, soulevé de terre)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregue peso a los levantamientos compuestos clave (sentadilla, banco, peso muerto)."
          }
        }
      }
    },
    "onboarding.goal.maintain.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay Fit & Consistent"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Formunu Koru ve Alışkanlık Kazan"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleiben Sie fit und konstant"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restez en forme et cohérent"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Manténgase en forma y constante"
          }
        }
      }
    },
    "onboarding.goal.maintain.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintain fitness, stay healthy, and build a lasting routine."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kondisyonunuzu koruyun, sağlıklı kalın ve kalıcı bir antrenman rutini oluşturun."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleiben Sie fit, bleiben Sie gesund und bauen Sie eine dauerhafte Routine auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez votre forme physique, restez en bonne santé et établissez une routine durable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Manténgase en forma, manténgase saludable y desarrolle una rutina duradera."
          }
        }
      }
    },
    "onboarding.experience.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is your lifting experience?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenman tecrübeniz nedir?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Erfahrungen haben Sie mit dem Heben gemacht?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle est votre expérience en matière de levage ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuál es tu experiencia en levantamiento?"
          }
        }
      }
    },
    "onboarding.experience.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We will tune exercise complexity and volume accordingly."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Egzersiz çeşitliliği ve set hacmini seviyenize göre ayarlayacağız."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir werden die Komplexität und das Volumen der Übung entsprechend anpassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous ajusterons la complexité et le volume des exercices en conséquence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
