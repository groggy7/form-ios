      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving cloud backups requires Forced Rep Premium. Existing backups can be restored for free."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulut yedeği kaydetmek için Forced Rep Premium gerekir. Mevcut yedekleri ücretsiz geri yükleyebilirsiniz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für das Speichern von Cloud-Backups ist Forced Rep Premium erforderlich. Vorhandene Backups können kostenlos wiederhergestellt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement des sauvegardes cloud nécessite Forced Rep Premium. Les sauvegardes existantes peuvent être restaurées gratuitement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar copias de seguridad en la nube requiere Forced Rep Premium. Las copias de seguridad existentes se pueden restaurar de forma gratuita."
          }
        }
      }
    },
    "form_lab.mirror_disabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on auto-sync before saving a backup."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedek kaydetmeden önce otomatik eşitlemeyi açın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere die automatische Synchronisierung, bevor du ein Backup speicherst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez la synchronisation automatique avant d'enregistrer une sauvegarde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la sincronización automática antes de guardar una copia de seguridad."
          }
        }
      }
    },
    "form_lab.mirror_no_backup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No backup found on this device or in iCloud Drive."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda veya iCloud Drive’da yedek bulunamadı."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät oder in iCloud Drive wurde kein Backup gefunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune sauvegarde trouvée sur cet appareil ou dans iCloud Drive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ninguna copia de seguridad en este dispositivo ni en iCloud Drive."
          }
        }
      }
    },
    "form_lab.mirror_discovery_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not check iCloud backups. Check your connection and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud yedekleri kontrol edilemedi. Bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-Backups konnten nicht überprüft werden. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier les sauvegardes iCloud. Vérifiez votre connexion et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron verificar las copias de seguridad de iCloud. Comprueba tu conexión y vuelve a intentarlo."
          }
        }
      }
    },
    "form_lab.mirror_download_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iCloud backup could not finish downloading. Check your connection and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud yedeği indirilemedi. Bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download des iCloud-Backups konnte nicht abgeschlossen werden. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde iCloud n'a pas pu terminer le téléchargement. Vérifiez votre connexion et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia de seguridad de iCloud no pudo terminar de descargarse. Comprueba tu conexión y vuelve a intentarlo."
          }
        }
      }
    },
    "form_lab.mirror_account_changed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple account changed. Use Sync Now to back up this device to the current account."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hesabınız değişti. Bu cihazı mevcut hesaba yedeklemek için Şimdi Eşitle’yi kullanın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Apple-Konto hat sich geändert. Verwende „Jetzt synchronisieren“, um dieses Gerät im aktuellen Konto zu sichern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte Apple a changé. Utilisez Synchroniser maintenant pour sauvegarder cet appareil sur le compte actuel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta de Apple cambió. Usa Sincronizar ahora para hacer una copia de seguridad de este dispositivo en la cuenta actual."
          }
        }
      }
    },
    "form_lab.mirror_newer_cloud": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A newer iCloud backup is available. Restore it, or use Sync Now to save this device’s data."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha yeni bir iCloud yedeği var. Geri yükleyin veya bu cihazın verilerini kaydetmek için Şimdi Eşitle’yi kullanın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neueres iCloud-Backup ist verfügbar. Stelle es wieder her oder verwende „Jetzt synchronisieren“, um die Daten dieses Geräts zu speichern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sauvegarde iCloud plus récente est disponible. Restaurez-la ou utilisez Synchroniser maintenant pour enregistrer les données de cet appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una copia de seguridad de iCloud más reciente. Restáurala o usa Sincronizar ahora para guardar los datos de este dispositivo."
          }
        }
      }
    },
