    "form_lab.info_brzycki_epley_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1RM Strength Formulas"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1RM Güç Formülleri"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1RM-Kraftformeln"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Formules de force 1RM"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fórmulas de fuerza 1RM"
          }
        }
      }
    },
    "form_lab.info_brzycki_epley_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These formulas calculate your estimated 1-rep max (1RM) from your heavy working sets (1–10 reps), so you never have to risk testing a dangerous true max in the gym. Brzycki is widely favored for lower reps (1–6), while Epley works great across 6–10 reps. Warmups and high-rep sets (11+) are safely excluded to keep your estimates realistic."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yöntemler, salonda sakatlık riski alıp gerçek 1 tekrar maksimumu denemenize gerek kalmadan, ağır çalışma setlerinizden (1–10 tekrar) tahmini gücünüzü hesaplar. Brzycki genellikle düşük tekrarlarda (1–6) çok tutarlıyken, Epley 6–10 tekrar aralığında sıkça tercih edilir. Tahminlerin gerçekçi kalması için ısınmalar ve yüksek tekrarlı setler (11+) hesaplamaya dahil edilmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Formeln berechnen Ihr geschätztes 1-Wiederholung-Maximum (1RM) aus Ihrem schweren Arbeitssätze (1–10 Wiederholungen), sodass Sie nie das Risiko eingehen müssen, im Fitnessstudio ein gefährliches echtes Maximum zu testen. Brzycki wird allgemein für niedrigere Wiederholungen (1–6) bevorzugt, während Epley bei Wiederholungen 6–10 hervorragend funktioniert. Aufwärmübungen und High-Wiederholung Sätze (11+) sind sicher ausgeschlossen, um Ihre Schätzungen realistisch zu halten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces formules calculent votre estimation de 1-répétition max (1RM) à partir de votre lourd séries de travail (1-10 répétitions), vous n'aurez donc jamais à risquer de tester un vrai maximum dangereux dans la salle de sport. Brzycki est largement préféré pour les répétitions inférieurs (1 à 6), tandis que Epley fonctionne très bien sur les répétitions 6 à 10. Les échauffements et les séries élevés (11+) sont exclus en toute sécurité pour que vos estimations restent réalistes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas fórmulas calculan tu 1-repetición máximo estimado (1RM) a partir de tu pesado series efectivas (1–10 repeticiones), por lo que nunca tendrás que arriesgarte a probar un verdadero máximo peligroso en el gimnasio. Brzycki es ampliamente preferido para repeticiones inferiores (1–6), mientras que Epley funciona muy bien en 6–10 repeticiones. Los calentamientos y repetición series alto (11+) se excluyen de forma segura para mantener sus estimaciones realistas."
          }
        }
      }
    },
    "form_lab.info_brzycki_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most accurate for heavy sets (1–6 reps)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağır setler için idealdir (1–6 tekrar)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am genauesten für schwere Sätze (1–6 Wiederholungen)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus précis pour les séries lourds (1 à 6 répétitions)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más preciso para series pesado (1–6 repeticiones)"
          }
        }
      }
    },
    "form_lab.info_epley_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Well-suited for moderate sets (6–10 reps)"
          }
        },
        "tr": {
