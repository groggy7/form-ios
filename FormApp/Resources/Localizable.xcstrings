    "programs.updateHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The program ID matches an existing program. Confirming replaces that program's plan, including any removals below. Other programs and past workout history are kept."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Program kimliği mevcut bir programla eşleşiyor. Onaylandığında aşağıdaki silmeler dahil bu programın planı değiştirilir. Diğer programlar ve antrenman geçmişi korunur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Programm-ID stimmt mit einem vorhandenen Programm überein. Beim Bestätigen wird der Plan dieses Programms ersetzt, einschließlich der unten aufgeführten Entfernungen. Andere Programme und der bisherige Trainingsverlauf bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ID du programme correspond à un programme existant. La confirmation remplace le plan de ce programme, y compris les suppressions ci-dessous. Les autres programmes et l'historique des entraînements antérieurs sont conservés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ID del programa coincide con un programa existente. La confirmación reemplaza el plan de ese programa, incluidas las eliminaciones a continuación. Se conservan otros programas y el historial de entrenamientos anteriores."
          }
        }
      }
    },
    "programs.addHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
