              "min": 10,
              "max": 12,
              "toFailure": false,
              "perSide": true
            },
            "restSeconds": 60,
            "cues": [
              "Stand perpendicular to cable.",
              "Extend cable handle straight out in front of chest.",
              "Resist all rotational torque."
            ],
            "avoid": [
              "Allowing torso or hips to twist."
            ]
          }
        ]
      },
      {
