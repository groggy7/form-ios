    "report.disclosure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submitting sends exercise details, category, comments, app version, language, and a random device ID. Do not include personal names, contact info, or medical history."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderildiğinde egzersiz bilgisi, kategori, açıklama, uygulama sürümü, dil ve rastgele bir cihaz kimliği iletilir. Lütfen ad, iletişim veya tıbbi geçmişinizi eklemeyin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Absenden werden Übungsdetails, Kategorie, Kommentare, App-Version, Sprache und eine zufällige Geräte-ID gesendet. Gib keine persönlichen Namen, Kontaktdaten oder Krankengeschichte an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La soumission envoie les détails de l'exercice, la catégorie, les commentaires, la version de l'application, la langue et un identifiant d'appareil aléatoire. N'incluez pas de noms personnels, de coordonnées ou d'antécédents médicaux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al enviarlo, se envían los detalles del ejercicio, la categoría, los comentarios, la versión de la app, el idioma y un identificador aleatorio del dispositivo. No incluyas nombres personales, datos de contacto ni historial médico."
          }
        }
      }
    },
