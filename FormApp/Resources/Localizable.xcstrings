    "onboarding.frequency.days3.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manageable and high-recovery. Great for full-body or athletic splits."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüksek toparlanma ve pratik. Tüm vücut veya atletik programlar için ideal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überschaubar und mit hoher Wiederherstellung. Ideal für Ganzkörper- oder sportliche Spagat-Übungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérable et haute récupération. Idéal pour les grands écarts sur tout le corps ou athlétiques."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Manejable y de alta recuperación. Ideal para divisiones atléticas o de cuerpo completo."
