    "form_lab.mirror_first_upload_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your backup is stored in this device’s iCloud account. Check the account in Settings → your name.\n\nFind the file in Files → Browse → iCloud Drive → Forced Rep → CloudMirror → {file}."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedeğiniz bu cihazın iCloud hesabında saklanıyor. Hesabı Ayarlar → adınız bölümünden kontrol edebilirsiniz.\n\nDosyayı Dosyalar → Göz At → iCloud Drive → Forced Rep → CloudMirror → {file} yolunda bulabilirsiniz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Backup wird im iCloud-Konto dieses Geräts gespeichert. Prüfe das Konto unter Einstellungen → dein Name.\n\nDu findest die Datei unter Dateien → Durchsuchen → iCloud Drive → Forced Rep → CloudMirror → {file}."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre sauvegarde est stockée dans le compte iCloud de cet appareil. Vérifiez le compte dans Paramètres → votre nom.\n\nRecherchez le fichier dans Fichiers → Parcourir → iCloud Drive → Forced Rep → CloudMirror → {file}."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu copia de seguridad se guarda en la cuenta de iCloud de este dispositivo. Comprueba la cuenta en Ajustes → tu nombre.\n\nBusca el archivo en Archivos → Explorar → iCloud Drive → Forced Rep → CloudMirror → {file}."
          }
        }
      }
    },
    "form_lab.mirror_invalid_backup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup data is invalid. Previous snapshots were preserved."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedek verileri geçersiz. Önceki yedekler korundu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sicherungsdaten sind ungültig. Frühere Schnappschüsse blieben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de sauvegarde ne sont pas valides. Les instantanés précédents ont été conservés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de la copia de seguridad no son válidos. Se conservaron instantáneas anteriores."
          }
        }
      }
    },
    "form_lab.mirror_free_restore": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore existing backups for free. Saving backups requires Premium."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut yedekleri ücretsiz geri yükleyin. Yedek kaydetmek için Premium gerekir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle vorhandene Backups kostenlos wieder her. Zum Speichern von Backups ist Premium erforderlich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurez gratuitement les sauvegardes existantes. L'enregistrement des sauvegardes nécessite Premium."
