    "form_lab.balance.quad_dominant_alert": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're logging more quad sets than hamstring sets."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka bacağa kıyasla daha fazla ön bacak (quad) seti yapıyorsunuz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie trainieren mehr Quadrizeps Sätze als Oberschenkelmuskeln Sätze."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous enregistrez plus de quad séries que d'ischio-jambiers séries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás registrando más series del cuádriceps que series del tendón de la corva."
          }
        }
      }
    },
    "form_lab.balance.ham_dominant_alert": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're logging more hamstring sets than quad sets."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ön bacağa kıyasla daha fazla arka bacak (hamstring) seti yapıyorsunuz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie beanspruchen mehr Oberschenkelmuskeln Sätze als Quadrizeps Sätze."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous enregistrez plus de séries aux ischio-jambiers que de quad séries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás registrando más series de tendón de la corva que series de cuádruple."
          }
        }
      }
    },
    "form_lab.balance.quad_ham_optimal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quad and hamstring volume is well-balanced. Great for comprehensive leg development."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ön bacak ve arka bacak setleri gayet dengeli. Bacak gelişimi için ideal bir oran."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Volumen der Quadrizeps- und Oberschenkelmuskulatur ist gut ausbalanciert. Ideal für eine umfassende Beinentwicklung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le volume des quadriceps et des ischio-jambiers est bien équilibré. Idéal pour le développement complet des jambes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El volumen de los cuádriceps y los isquiotibiales está bien equilibrado. Ideal para el desarrollo integral de las piernas."
          }
        }
      }
    },
    "form_lab.balance.quad_dominant_rec": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consider adding Romanian deadlifts or hamstring curls to give the back of your legs equal focus."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bacaklarınızın arka kısmını dengelemek için RDL (Romanian deadlift) veya leg curl ekleyebilirsiniz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erwägen Sie, rumänisches Kreuzheben oder Kniesehnencurls hinzuzufügen, um der Rückseite Ihrer Beine den gleichen Fokus zu verleihen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensez à ajouter des soulevés de terre roumains ou des boucles aux ischio-jambiers pour donner à l’arrière de vos jambes une concentration égale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Considere agregar peso muerto rumano o flexiones de isquiotibiales para darle la misma atención a la parte posterior de sus piernas."
          }
        }
      }
    },
    "form_lab.balance.ham_dominant_rec": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consider adding squats, leg presses, or lunges if you want to balance out quad volume."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ön bacak hacmini dengelemek isterseniz squat, leg press veya lunge gibi hareketleri artırabilirsiniz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erwägen Sie das Hinzufügen von Kniebeugen, Beinpressen oder Ausfallschritten, wenn Sie das Quadrizepsvolumen ausgleichen möchten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensez à ajouter des squats, des presses à jambes ou des fentes si vous souhaitez équilibrer le volume quadruple."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Considere agregar sentadillas, prensas de piernas o estocadas si desea equilibrar el volumen de los cuádriceps."
          }
        }
      }
    },
    "form_lab.balance.quad_ham_optimal_rec": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep up the balanced work between your squats/presses and hinge/curl movements."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Squat/pres hareketleri ile arka bacak egzersizleriniz arasındaki bu dengeyi koruyun."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalten Sie die ausgewogene Arbeit zwischen Ihren Kniebeugen/Pressen und Scharnier-/Lockenbewegungen bei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez le travail équilibré entre vos squats/presses et vos mouvements de charnière/boucle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga el trabajo equilibrado entre sus sentadillas/press y movimientos de bisagra/curvatura."
          }
        }
      }
    },
    "form_lab.balance.upper_lower_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
