    "onboarding.reason.homeForge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matched for home training with dumbbells and an adjustable bench with balanced frequency."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evde dambıl ve ayarlanabilir sehpa ile dengeli frekansta antrenman için eşleştirildi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passend für Heimtraining mit Kurzhanteln und einer verstellbaren Bank mit ausgewogener Frequenz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapté pour l'entraînement à domicile avec haltères et un banc réglable à fréquence équilibrée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinado para entrenar en casa con mancuernas y un banco ajustable con frecuencia equilibrada."
          }
        }
      }
    },
    "onboarding.reason.machineFoundation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matched for machine and cable guidance with low joint impact and zero barbell setup required."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düşük eklem baskısı, serbest ağırlık kurulumu olmadan makinelerle güvenli antrenman için eşleştirildi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgestimmt auf die Maschinen- und Kabelführung mit geringem Gelenkstoß und ohne Langhantel-Einrichtung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapté au guidage de la machine et des câbles avec un faible impact sur les joints et aucune configuration barre requise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinado para guiar máquinas y cables con bajo impacto en las juntas y sin necesidad de configuración barra."
          }
        }
      }
    },
    "onboarding.reason.classicPpl": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matched for 6 days of dedicated Push, Pull, and Legs training with high hypertrophy volume."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftada 6 gün adanmış İtiş, Çekiş ve Bacak hipertrofi hacmi için eşleştirildi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passend für 6 Tage gezieltes Push-, Pull- und Beintraining mit hohem Hypertrophievolumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associé à 6 jours d'entraînement dédié Push, Pull et Legs avec un volume d'hypertrophie élevé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinados durante 6 días de entrenamiento dedicado de empuje, tracción y piernas con alto volumen de hipertrofia."
          }
        }
      }
    },
    "onboarding.reason.aestheticHypertrophy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matched for 5-day balanced upper/lower physique development with extra shoulder focus."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 günlük dengeli üst/alt vücut gelişimi ve ekstra omuz vurgusu için eşleştirildi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passend für eine 5-tägige ausgewogene Entwicklung des Ober- und Unterkörpers mit besonderem Fokus auf die Schulter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapté pour un développement équilibré du haut et du bas du corps sur 5 jours avec une concentration supplémentaire sur les épaules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinado para un desarrollo físico equilibrado de la parte superior/inferior durante 5 días con especial atención en los hombros."
          }
        }
      }
    },
    "onboarding.reason.powerbuildingStrength": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matched for 4-day heavy compound progression (squat, bench, deadlift) paired with hypertrophy accessory work."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "4 günlük ağır temel kaldırışlar (squat, bench, deadlift) ve hipertrofi aksesuarları için eşleştirildi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geeignet für 4-tägige schwere Compound-Fortschritte (Kniebeugen, Bankdrücken, Kreuzheben) gepaart mit Hypertrophie-Hilfsübungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapté à une progression composée lourde de 4 jours (squat, banc, soulevé de terre) associée à un travail accessoire d'hypertrophie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinado para una progresión compuesta pesada de 4 días (sentadilla, banco, peso muerto) combinada con trabajo accesorio de hipertrofia."
          }
        }
      }
    },
    "onboarding.reason.upperLower": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matched for 4-day upper/lower balance hitting each major muscle group twice a week with optimal recovery."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftada iki kez her kas grubunu çalıştıran 4 günlük dengeli Üst/Alt bölüşümü için eşleştirildi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgestimmt auf eine 4-tägige obere/untere Balance, bei der jede große Muskelgruppe zweimal pro Woche trainiert und eine optimale Erholung erzielt wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapté pour un équilibre supérieur/inférieur de 4 jours en frappant chaque groupe musculaire majeur deux fois par semaine avec une récupération optimale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinado para un equilibrio superior/inferior de 4 días que golpea cada grupo muscular principal dos veces por semana con una recuperación óptima."
          }
        }
      }
    },
    "onboarding.reason.athleticPerformance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matched for 3-day power, explosiveness, and athletic movement patterns."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftada 3 gün patlayıcı güç, hız ve atletik hareket kalıpları için eşleştirildi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passend für 3-Tage-Power, Explosivität und athletische Bewegungsmuster."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapté à la puissance, à l'explosivité et aux mouvements athlétiques sur 3 jours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinado para patrones de potencia, explosividad y movimiento atlético de 3 días."
          }
        }
      }
    },
    "onboarding.reason.fullBodyClassic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matched for 3-day whole-body training repeating key movement patterns with high efficiency."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftada 3 gün temel hareketleri yüksek verimle tekrarlayan tüm vücut antrenmanı için eşleştirildi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgestimmt auf ein 3-tägiges Ganzkörpertraining, bei dem wichtige Bewegungsmuster mit hoher Effizienz wiederholt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapté à un entraînement complet du corps de 3 jours répétant des schémas de mouvements clés avec une grande efficacité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinado para un entrenamiento de cuerpo entero de 3 días repitiendo patrones de movimiento clave con alta eficiencia."
          }
        }
      }
    },
