    "paywall.cloud_backup.benefit1_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a local copy and write to iCloud Drive when available. iCloud handles upload."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kopya cihazına, varsa iCloud Drive'a kaydedilir. Yüklemeyi iCloud yönetir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kopie bleibt lokal. Wenn iCloud Drive verfügbar ist, wird eine weitere in deinem privaten Bereich gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une copie reste sur l’appareil. Une autre est enregistrée dans votre espace privé si iCloud Drive est disponible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia permanece en el dispositivo. Si iCloud Drive está disponible, se guarda otra en tu espacio privado."
          }
        }
      }
    },
