        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schätzungen beruhen auf Arbeitssätzen mit 1–10 Wiederholungen. Die Verteilung vergleicht die Zuordnung der Sätze."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les estimations utilisent des séries de travail de 1 à 10 répétitions. La répartition compare l’attribution des séries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las estimaciones usan series efectivas de 1 a 10 repeticiones. La distribución compara el reparto de series."
          }
        }
