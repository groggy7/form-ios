      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pure Push, Pull, Legs frequency for experienced, high-recovery lifters."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İleri seviye lifterlar için saf İtiş, Çekiş, Bacak frekansı."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
