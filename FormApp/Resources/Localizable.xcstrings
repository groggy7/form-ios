    "table.assistance_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter assistance weight. Less assistance means more resistance; 0 means no assistance."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Destek ağırlığını gir. Daha az destek, daha fazla direnç demektir; 0, desteksizdir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie das Unterstützungsgewicht ein. Weniger Hilfe bedeutet mehr Widerstand; 0 bedeutet keine Unterstützung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez le poids d'assistance. Moins d’assistance signifie plus de résistance ; 0 signifie aucune aide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduzca el peso de asistencia. Menos asistencia significa más resistencia; 0 significa que no hay asistencia."
          }
        }
      }
    },
    "progression.coach.assistance_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep assistance, build reps"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteği koru, tekrar geliştir"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterstützen Sie uns, bauen Sie Wiederholungen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez l'assistance, construisez répétitions"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener asistencia, construir repeticiones"
          }
        }
      }
    },
    "progression.rationale.assistance_reps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the same assistance and build reps if manageable. Less assistance makes the exercise harder."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapabiliyorsan aynı destekle tekrarları geliştir. Daha az destek, hareketi zorlaştırır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalten Sie die gleiche Unterstützung bei und erstellen Sie Wiederholungen, sofern dies überschaubar ist. Weniger Unterstützung macht die Übung schwieriger."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez la même assistance et construisez répétitions si cela est gérable. Moins d’assistance rend l’exercice plus difficile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga la misma asistencia y cree repeticiones si es manejable. Menos asistencia hace que el ejercicio sea más difícil."
          }
        }
      }
    },
    "progression.rationale.assistance_ceiling": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeat these reps with the same assistance. If manageable, choose less assistance yourself; the app does not choose a reduction."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı destekle bu tekrarları yinele. Yapabiliyorsan desteği kendin azalt; uygulama bir azaltma seçmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederholen Sie diese Schritte mit der gleichen Hilfe. Wenn es machbar ist, wählen Sie selbst weniger Unterstützung; Die App wählt keine Ermäßigung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répétez ces répétitions avec la même assistance. Si cela est gérable, choisissez vous-même moins d’assistance ; l'application ne choisit pas de réduction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repita estos repeticiones con la misma ayuda. Si es posible, elija usted mismo menos asistencia; la aplicación no elige una reducción."
          }
        }
      }
    },
